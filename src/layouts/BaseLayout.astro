---
import SplashCursor from "../components/SplashCursor";
import SiteBrand from "../components/SiteBrand.astro";

interface Props {
  title: string;
  description?: string;
  bodyClass?: string;
  showSplashCursor?: boolean;
  ogType?: "website" | "article";
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  article?: { headline: string; datePublished: string; dateModified?: string };
}

const {
  title,
  description = "Aniloom Technologies builds and supports digital products across software engineering, games, playable experiences, quality engineering, design, and art.",
  bodyClass = "",
  showSplashCursor = true,
  ogType = "website",
  image,
  imageAlt,
  imageWidth,
  imageHeight,
  article,
} = Astro.props;

const pathname = Astro.url.pathname;
const canonical = new URL(pathname, "https://aniloom.tech");
const socialImage = image ? new URL(image, canonical) : null;
const organizationId = "https://aniloom.tech/#organization";
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "Organization", "@id": organizationId, name: "Aniloom Technologies", url: "https://aniloom.tech/", email: "support@aniloom.tech" },
    { "@type": "WebSite", "@id": "https://aniloom.tech/#website", url: "https://aniloom.tech/", name: "Aniloom Technologies", publisher: { "@id": organizationId } },
    ...(article ? [{ "@type": "Article", "@id": `${canonical}#article`, mainEntityOfPage: canonical.toString(), headline: article.headline, description, datePublished: article.datePublished, ...(article.dateModified ? { dateModified: article.dateModified } : {}), author: { "@id": organizationId }, publisher: { "@id": organizationId }, ...(socialImage ? { image: socialImage.toString() } : {}) }] : []),
  ],
};
const navItems = [
  { href: "/capabilities/", label: "Capabilities", match: "/capabilities" },
  { href: "/playable-ads/", label: "Playable Ads", match: "/playable-ads" },
  { href: "/quality-engineering/", label: "Quality Engineering", match: "/quality-engineering" },
  { href: "/how-we-work/", label: "How We Work", match: "/how-we-work" },
  { href: "/about/", label: "About", match: "/about" },
  { href: "/insights/", label: "Notes", match: "/insights" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#07131a" />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content="Aniloom Technologies" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.toString()} />
    {socialImage && <meta property="og:image" content={socialImage.toString()} />}
    {socialImage && <meta property="og:image:type" content="image/webp" />}
    {socialImage && imageAlt && <meta property="og:image:alt" content={imageAlt} />}
    {socialImage && imageWidth && <meta property="og:image:width" content={String(imageWidth)} />}
    {socialImage && imageHeight && <meta property="og:image:height" content={String(imageHeight)} />}
    <meta name="twitter:card" content={socialImage ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {socialImage && <meta name="twitter:image" content={socialImage.toString()} />}
    {socialImage && imageAlt && <meta name="twitter:image:alt" content={imageAlt} />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g, "\\u003c")} />
    <style is:inline>
      html, body { background: #07131a; color: #f5f8fa; }
    </style>
    <link rel="stylesheet" href="/assets/css/styles.css" />
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main-content">Skip to content</a>

    {showSplashCursor && (
      <SplashCursor
        client:media="(hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)"
        DYE_RESOLUTION={768}
        SIM_RESOLUTION={72}
        SPLAT_RADIUS={0.1}
        SPLAT_FORCE={3200}
        COLOR_UPDATE_SPEED={5}
      />
    )}

    <header class="site-header" data-site-header>
      <SiteBrand />

      <button class="menu-toggle" type="button" data-menu-toggle aria-expanded="false" aria-controls="site-navigation">
        <span>Menu</span>
        <span class="menu-toggle__icon" aria-hidden="true"></span>
      </button>

      <nav class="site-nav" id="site-navigation" data-site-nav aria-label="Primary navigation">
        {navItems.map((item) => (
          <a href={item.href} aria-current={pathname.startsWith(item.match) ? "page" : undefined}>{item.label}</a>
        ))}
        <button class="button button--small" type="button" data-contact-open>Discuss your project</button>
      </nav>
    </header>

    <div class="page-shell"><slot /></div>

    <div class="contact-modal" data-contact-modal aria-hidden="true">
      <div class="contact-modal__backdrop" data-contact-close></div>
      <div class="contact-modal__content" role="dialog" aria-modal="true" aria-labelledby="contact-modal-title" tabindex="-1">
        <button class="contact-modal__close" type="button" aria-label="Close contact form" data-contact-close><span></span><span></span></button>
        <span class="eyebrow">A practical first conversation</span>
        <h2 id="contact-modal-title">What does your product need next?</h2>
        <p>Share your goal, the current build or brief, and your target timeline. We will help define the next step.</p>
        <p data-contact-topic-label hidden></p>
        <form class="contact-form" data-contact-form>
          <input type="hidden" name="topic" />
          <label class="contact-field"><span>Name</span><input type="text" name="name" autocomplete="name" required /></label>
          <label class="contact-field"><span>Email</span><input type="email" name="email" autocomplete="email" required /></label>
          <label class="contact-field contact-field--full"><span>Product or project</span><textarea name="project" rows="5" placeholder="What are you building, where is it now, and what needs to change?" required></textarea></label>
          <button class="button" type="submit" aria-describedby="contact-draft-note">Draft email</button>
          <p class="contact-form__note" id="contact-draft-note">This opens a draft in your email app. Nothing is sent from the website.</p>
        </form>
        <p class="contact-modal__direct">Or email <a href="mailto:support@aniloom.tech">support@aniloom.tech</a></p>
      </div>
    </div>

    <div class="site-footer-stage" data-footer-stage>
      <footer class="site-footer">
        <div class="site-footer__inner">
          <div class="site-footer__lead">
            <p class="eyebrow">Aniloom Technologies</p>
            <h2>Bring the goal.<br />We will shape the work.</h2>
            <button class="text-link text-link--large" type="button" data-contact-open>Discuss your project <span>↗</span></button>
          </div>
          <div class="site-footer__grid">
            <div>
              <SiteBrand />
              <p class="site-footer__summary">Software development, design, and testing for web, mobile, games, and interactive products.</p>
            </div>
            <div class="site-footer__links">
              <p class="footer-label">Explore</p>
              <a href="/capabilities/">Capabilities</a><a href="/playable-ads/">Playable Ads</a><a href="/playable-ads/pricing/">Playable Pricing</a><a href="/quality-engineering/">Quality Engineering</a><a href="/quality-engineering/pricing/">QA Pricing</a><a href="/insights/">Notes</a>
            </div>
            <div class="site-footer__links">
              <p class="footer-label">Company</p>
              <a href="/how-we-work/">How We Work</a><a href="/about/">About</a><a href="mailto:support@aniloom.tech">Email us</a><a href="/privacy-policy/">Privacy</a><a href="/terms-of-use/">Terms</a>
            </div>
          </div>
          <div class="site-footer__bottom"><span>© 2026 Aniloom Technologies LLC</span><span>Built for useful conversations.</span></div>
        </div>
      </footer>
      <div class="site-footer__pull" data-footer-pull aria-hidden="true">
        <blockquote class="site-footer__quote" data-footer-quote><p data-footer-quote-text></p><cite data-footer-quote-source></cite></blockquote>
      </div>
    </div>

    <script src="/assets/js/contact-modal.js" defer></script>
    <script src="/assets/js/footer-pull.js" defer></script>
    <script src="/assets/js/site.js" defer></script>
  </body>
</html>
