---
import BaseLayout from "../layouts/BaseLayout.astro";
import GradientText from "../components/GradientText.astro";
import ReleaseIllustration from "../components/ReleaseIllustration.astro";
import JourneyArrow from "../components/JourneyArrow.astro";

const entryPoints = [
  { number: "01", title: "Check a release", text: "Test a release candidate or a critical user journey. Receive prioritized findings and a summary of what was tested and what remains open." },
  { number: "02", title: "Support ongoing development", text: "Add regular feature and regression testing, or automate stable web regression flows. Choose the package that fits your product and release schedule." },
  { number: "03", title: "Build a QA system", text: "Set up a risk map, defect workflow, release checklist, and documented regression scenarios that your team can keep using." },
];
const releaseSteps = [
  { state: "hidden-bugs" as const, title: "Start with your build", text: "Share a working build, critical user journeys, and target configurations. Some defects may still be hidden." },
  { state: "bug-found" as const, title: "Find and document defects", text: "We test the agreed scope and report reproducible issues with evidence, priorities, and coverage gaps." },
  { state: "retested" as const, title: "Retest after fixes", text: "Your development team makes the corrections. We retest the agreed changes and report what is resolved and what remains open." },
];
---

<BaseLayout title="Quality Engineering & Testing | Aniloom Technologies" description="Risk-based quality engineering and testing for release checks, ongoing development, and reusable QA systems." image="/assets/images/editorial/quality-engineering-v2.webp" imageAlt="Editorial illustration of product-risk paths, evidence, and a release decision gate." imageWidth={1400} imageHeight={1050}>
  <main id="main-content">
    <section class="page-hero page-hero--service section-shell">
      <p class="eyebrow" data-reveal>Quality Engineering & Testing</p>
      <h1 data-reveal>Software testing for your next <GradientText>release.</GradientText></h1>
      <p class="page-hero__lead" data-reveal>We test the user journeys whose failure would matter most to your product. Receive clear defect reports, test coverage and gaps, and the information needed for a release decision.</p>
      <div class="page-hero__actions" data-reveal><a class="button" href="/contact/">Discuss testing</a><a class="text-link" href="/quality-engineering/pricing/">View packages & pricing <span>↗</span></a></div>
    </section>

    <section class="playable-journey release-journey section-shell section-pad" aria-labelledby="release-journey-title">
      <div class="section-heading">
        <div><p class="eyebrow">How release testing works</p><h2 id="release-journey-title">From hidden bugs to verified fixes.</h2></div>
        <p>Testing makes defects visible. Your team corrects them, and our retest checks the changes before your release decision.</p>
      </div>
      <ol class="playable-journey__steps" role="list">
        {releaseSteps.map((step, index) => (
          <li class="playable-journey__step">
            <ReleaseIllustration state={step.state} />
            <div class="playable-journey__copy"><h3><span>0{index + 1}</span> {step.title}</h3><p>{step.text}</p></div>
            {index < releaseSteps.length - 1 && <JourneyArrow class="playable-journey__arrow" />}
          </li>
        ))}
      </ol>
      <p class="playable-journey__note">Illustrated testing cycle. Engineering corrections are outside the testing scope. The final illustration represents retested changes, not a guarantee of a defect-free product.</p>
    </section>

    <section class="entry-points section-shell section-pad" id="entry-points">
      <div class="section-heading" data-reveal><div><p class="eyebrow">Three useful entry points</p><h2>Start where the product needs help.</h2></div><p>Choose a release check, regular QA support, or a QA setup project. Each package defines its scope and deliverables.</p></div>
      <div class="entry-grid">
        {entryPoints.map((entry) => <article data-reveal><span>{entry.number}</span><h2>{entry.title}</h2><p>{entry.text}</p></article>)}
      </div>
    </section>

    <section class="quality-lead surface-dark section-pad">
      <div class="section-shell quality-lead__grid">
        <div data-reveal><p class="eyebrow">Practice leadership</p><h2>QA standards led by Olena.</h2><p>Olena leads Aniloom’s Quality Engineering practice and designs the systems, standards, and delivery workflows used by the team. Execution scales through a consistent distributed QA team according to project scope.</p></div>
        <div class="quality-orbit" data-reveal aria-label="Quality engineering concerns"><span>Product risk</span><span>Critical flows</span><span>Evidence</span><span>Release gates</span><strong>Decision</strong></div>
      </div>
    </section>

    <section class="deliverable section-shell section-pad">
      <div class="section-heading" data-reveal><div><p class="eyebrow">Deliverables by engagement</p><h2>Know what you will receive.</h2></div><p>Each package includes a different set of outputs. The proposal confirms the deliverables for your product; testing does not guarantee a defect-free release.</p></div>
      <div class="deliverable-grid">
        <div data-reveal><span>Risk and test plan</span><p>QA Setup for Startups maps product risks, ownership, and the user journeys that need regression coverage.</p></div>
        <div data-reveal><span>Test coverage and gaps</span><p>Release checks identify the journeys and configuration profiles tested, with blocked or untested areas recorded.</p></div>
        <div data-reveal><span>Prioritized defect report</span><p>Release checks and ongoing QA document observed issues with reproduction context and supporting evidence.</p></div>
        <div data-reveal><span>Release-readiness summary</span><p>Release checks summarize findings, retest results, and remaining risks for the release decision.</p></div>
        <div data-reveal><span>Reusable regression checks</span><p>QA Setup includes documented scenarios and a release checklist. Regression Automation delivers test code and run instructions.</p></div>
        <div data-reveal><span>Ongoing QA reports</span><p>Monthly Product QA Support includes weekly asynchronous status and a monthly quality summary.</p></div>
      </div>
    </section>

    <section class="service-crosslink section-shell" data-reveal>
      <p class="eyebrow">Interactive-ad release</p>
      <div><h2>Need a playable ad tested before launch?</h2><a class="text-link" href="/playable-ads/#qa-release-readiness">Explore Playable QA & Release Readiness <span>↗</span></a></div>
    </section>

    <section class="callout surface-dark section-shell section-pad"><p class="eyebrow">Start with your product</p><h2>Tell us what you need tested.</h2><p>Share the current build, critical user journeys, platforms, known issues, and target release date.</p><a class="button" href="/contact/">Discuss testing</a></section>
  </main>
</BaseLayout>
