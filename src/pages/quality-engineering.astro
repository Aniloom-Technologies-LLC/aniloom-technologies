---
import BaseLayout from "../layouts/BaseLayout.astro";
import GradientText from "../components/GradientText.astro";

const entryPoints = [
  { number: "01", title: "Check a release", text: "Review an identified release candidate against agreed critical flows, configurations, defects, evidence, and decision gates." },
  { number: "02", title: "Support ongoing development", text: "Add a consistent quality rhythm through functional testing, regression, release review, performance, UX, compatibility, and selected automation." },
  { number: "03", title: "Build a QA system", text: "Create or refine risk mapping, regression tiers, critical-flow playbooks, configuration coverage, defect standards, release gates, and handoff documentation." },
];
---

<BaseLayout title="Quality Engineering & Testing | Aniloom Technologies" description="Risk-based quality engineering and testing for release checks, ongoing development, and reusable QA systems.">
  <main id="main-content">
    <section class="page-hero page-hero--service section-shell">
      <p class="eyebrow" data-reveal>Quality Engineering & Testing</p>
      <h1 data-reveal>Make the release decision with the <GradientText>risk in view.</GradientText></h1>
      <p class="page-hero__lead" data-reveal>We organize testing around the flows and configurations whose failure would matter most, then make tested areas, open defects, coverage gaps, and accepted risks visible.</p>
      <div class="page-hero__actions" data-reveal><button class="button" type="button" data-contact-open>Discuss a quality challenge</button><a class="text-link" href="#entry-points">Choose an entry point <span>↓</span></a></div>
    </section>

    <figure class="service-artwork section-shell" data-reveal>
      <picture>
        <source srcset="/assets/images/editorial/quality-engineering.avif" type="image/avif" />
        <img src="/assets/images/editorial/quality-engineering.webp" alt="Abstract product-risk paths moving through evidence layers, with a release route passing a decision gate while an open-risk branch remains visible." width="1440" height="1080" loading="lazy" decoding="async" />
      </picture>
    </figure>

    <section class="entry-points section-shell section-pad" id="entry-points">
      <div class="section-heading" data-reveal><div><p class="eyebrow">Three useful entry points</p><h2>Start where the product needs help.</h2></div><p>The engagement can focus on an immediate release, become part of the delivery cadence, or establish a quality system the team can maintain.</p></div>
      <div class="entry-grid">
        {entryPoints.map((entry) => <article data-reveal><span>{entry.number}</span><h2>{entry.title}</h2><p>{entry.text}</p></article>)}
      </div>
    </section>

    <section class="quality-lead section-pad">
      <div class="section-shell quality-lead__grid">
        <div data-reveal><p class="eyebrow">Practice leadership</p><h2>Quality is designed, not added at the end.</h2><p>Olena leads Aniloom’s Quality Engineering practice and designs the systems, standards, and delivery workflows used by the team. Execution scales through a consistent distributed QA team according to project scope.</p></div>
        <div class="quality-orbit" data-reveal aria-label="Quality engineering concerns"><span>Product risk</span><span>Critical flows</span><span>Evidence</span><span>Release gates</span><strong>Decision</strong></div>
      </div>
    </section>

    <section class="deliverable section-shell section-pad">
      <div class="section-heading" data-reveal><div><p class="eyebrow">Possible deliverables</p><h2>Useful controls that remain after the test run.</h2></div><p>The exact set is agreed by scope. Aniloom does not present this work as certification or a guarantee of defect-free release.</p></div>
      <div class="deliverable-grid">
        <div data-reveal><span>Risk view</span><p>Product risk and critical-flow map tied to the current decision.</p></div>
        <div data-reveal><span>Coverage</span><p>Risk-tiered regression structure and a prioritized configuration matrix.</p></div>
        <div data-reveal><span>Evidence</span><p>Actionable defect register, tested states, blocked areas, and coverage gaps.</p></div>
        <div data-reveal><span>Decision</span><p>Release-readiness assessment with open risks, owners, and agreed gates.</p></div>
        <div data-reveal><span>Continuity</span><p>Reusable playbooks, checklists, documentation, and maintenance guidance.</p></div>
        <div data-reveal><span>Measurement</span><p>Definitions or a baseline for measures that support better future decisions.</p></div>
      </div>
    </section>

    <section class="service-crosslink section-shell" data-reveal>
      <p class="eyebrow">Interactive-ad release</p>
      <div><h2>Testing a playable against campaign and platform constraints?</h2><a class="text-link" href="/playable-ads/">Explore Playable Release Quality <span>↗</span></a></div>
    </section>

    <section class="callout section-shell section-pad" data-reveal><p class="eyebrow">Bring the current decision</p><h2>What does your team need to know before it moves forward?</h2><p>We can begin with the product state, the release pressure, and the evidence you already have.</p><button class="button" type="button" data-contact-open>Discuss a quality challenge</button></section>
  </main>
</BaseLayout>
