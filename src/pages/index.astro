---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import FloatingLines from "../components/FloatingLines";
import GradientText from "../components/GradientText.astro";

const posts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime())
  .slice(0, 2);

const capabilities = [
  { index: "01", title: "Product Engineering", text: "Websites, applications, internal tools, product recovery, and continuing development shaped around a useful product state.", href: "/capabilities/#product-engineering" },
  { index: "02", title: "Games & Playables", text: "Unity games, browser experiences, playable ads, microgames, and gamification where interaction has a clear job to do.", href: "/capabilities/#games-playables" },
  { index: "03", title: "Quality Engineering", text: "Risk-based testing, release readiness, regression structure, performance review, and quality systems teams can keep using.", href: "/quality-engineering/" },
  { index: "04", title: "Design & Art", text: "UI/UX, visual direction, 2D and 3D production, character work, and animation connected to implementation.", href: "/capabilities/#design-art" },
];
---

<BaseLayout title="Aniloom Technologies | Software development, design, and testing" bodyClass="home-page">
  <main id="main-content">
    <section class="hero section-shell">
      <FloatingLines client:media="(hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)" enabledWaves={["middle", "bottom"]} lineCount={[5, 4]} lineDistance={[8, 10]} linesGradient={["#FFC000", "#56D3FF", "#FFFFFF"]} bendStrength={-0.25} maxPixelRatio={1.5} />
      <div class="hero__content">
        <div class="hero__eyebrow-row" data-reveal>
          <span class="eyebrow">Software company</span>
          <span class="availability"><span></span> Accepting new client work</span>
        </div>
        <h1 data-reveal>Build your next product with <GradientText>Aniloom.</GradientText></h1>
        <div class="hero__lower" data-reveal>
          <p class="hero__lead">Software development, design, and testing for web, mobile, games, and interactive products.</p>
          <div class="hero__actions"><button class="button" type="button" data-contact-open>Discuss your project</button><a class="text-link" href="/capabilities/">Explore capabilities <span>↗</span></a></div>
        </div>
      </div>
      <div class="hero__signal" aria-hidden="true"><span>Engineering</span><span>Quality</span><span>Design</span><span>Art</span></div>
    </section>

    <section class="statement section-shell section-pad" data-reveal>
      <p class="eyebrow">A managed development partner</p>
      <p class="statement__copy">Your team brings the goal. We identify the expertise that is missing and manage the engineering, testing, design, and art needed to move the product forward.</p>
      <div class="principle-line"><span>AI moves the work faster.</span><span>Experienced people remain responsible for what ships.</span></div>
    </section>

    <section class="capability-index section-shell section-pad" id="capabilities">
      <div class="section-heading" data-reveal>
        <div><p class="eyebrow">Capabilities</p><h2>One product.<br />Connected expertise.</h2></div>
        <p>Different product stages require different disciplines. We bring them together around a defined result instead of selling isolated activity.</p>
      </div>
      <div class="capability-navigator">
        <nav class="capability-list" aria-label="Aniloom capabilities">
          {capabilities.map((item) => (
            <a class="capability-row" href={item.href} data-reveal>
              <span class="capability-row__index">{item.index}</span>
              <span class="capability-row__copy"><strong>{item.title}</strong><span>{item.text}</span></span>
              <span class="capability-row__arrow" aria-hidden="true">↗</span>
            </a>
          ))}
        </nav>
        <figure class="capability-navigator__visual" data-reveal>
          <picture>
            <source srcset="/assets/images/editorial/product-flow-review.avif" type="image/avif" />
            <img src="/assets/images/editorial/product-flow-review.webp" alt="An editorial product-flow review showing connected states and decisions." width="1440" height="960" loading="lazy" decoding="async" />
          </picture>
          <figcaption><span>Engineering</span><span>Quality</span><span>Design</span><span>Art</span></figcaption>
        </figure>
      </div>
    </section>

    <section class="product-stories" aria-label="Focused products">
      <article class="product-story product-story--playable" data-reveal>
        <a class="product-story__canvas-link" href="/playable-ads/" aria-label="Learn more about Playable Ads"></a>
        <picture class="product-story__media" aria-hidden="true">
          <source srcset="/assets/images/editorial/playable-ads-v2.avif" type="image/avif" />
          <img src="/assets/images/editorial/playable-ads-v2.webp" alt="" width="1400" height="1050" loading="lazy" decoding="async" />
        </picture>
        <div class="product-story__veil" aria-hidden="true"></div>
        <div class="product-story__content section-shell">
          <div class="product-story__heading"><p class="eyebrow">Focused product</p><span>01</span></div>
          <div class="product-story__message">
            <h2>Playable Ads</h2>
            <p>Build a focused interactive experience or review an existing playable across its journey, responsive states, variants, and release constraints.</p>
            <div class="product-story__actions"><a class="button" href="/playable-ads/">Learn more</a><a class="button button--secondary" href="/playable-ads/pricing/">View pricing</a></div>
          </div>
        </div>
      </article>

      <article class="product-story product-story--quality surface-light" data-reveal>
        <a class="product-story__canvas-link" href="/quality-engineering/" aria-label="Learn more about Release Testing and Quality Engineering"></a>
        <picture class="product-story__media" aria-hidden="true">
          <source srcset="/assets/images/editorial/quality-engineering-v2.avif" type="image/avif" />
          <img src="/assets/images/editorial/quality-engineering-v2.webp" alt="" width="1400" height="1050" loading="lazy" decoding="async" />
        </picture>
        <div class="product-story__veil" aria-hidden="true"></div>
        <div class="product-story__content section-shell">
          <div class="product-story__heading"><p class="eyebrow">Focused product</p><span>02</span></div>
          <div class="product-story__message">
            <h2>Release Testing</h2>
            <p>Make product risk, critical flows, tested states, coverage gaps, and the next release decision easier to see and act on.</p>
            <div class="product-story__actions"><a class="button" href="/quality-engineering/">Learn more</a><a class="button button--secondary" href="/quality-engineering/pricing/">View pricing</a></div>
          </div>
        </div>
      </article>
    </section>

    <section class="process section-pad">
      <div class="section-shell">
        <div class="section-heading" data-reveal><div><p class="eyebrow">How we work</p><h2>Built around the decision that comes next.</h2></div><p>Every engagement starts by making the goal, responsibility, and evidence of completion clear.</p></div>
        <ol class="process-grid">
          <li data-reveal><span>01</span><h3>Frame the goal</h3><p>We clarify the product state, release, recovery point, or delivery cadence the work needs to achieve.</p></li>
          <li data-reveal><span>02</span><h3>Shape the expertise</h3><p>We choose the disciplines, tools, and workflow that fit the goal rather than prescribing headcount.</p></li>
          <li data-reveal><span>03</span><h3>Build with visible checks</h3><p>Reviews, tested states, open decisions, and responsibilities stay clear while the product moves forward.</p></li>
        </ol>
        <a class="text-link" href="/how-we-work/">See how engagements work <span>↗</span></a>
      </div>
    </section>

    <section class="people section-shell section-pad">
      <div class="section-heading" data-reveal><div><p class="eyebrow">People stay visible</p><h2>Responsibility has a name.</h2></div><p>Better tools create more capability. They do not remove judgment, review, or accountability from the people doing the work.</p></div>
      <div class="people-editorial">
        <article data-reveal><span class="people-editorial__index">01</span><div><p class="eyebrow">Founder & CEO</p><h3>Ino</h3><p>Company direction, major client relationships, and solution judgment, informed by more than 10 years of professional game-development experience.</p></div></article>
        <article data-reveal><span class="people-editorial__index">02</span><div><p class="eyebrow">Co-Founder & COO</p><h3>Olena</h3><p>Leads Aniloom’s Quality Engineering practice and designs the systems, standards, and delivery workflows used by the team.</p></div></article>
      </div>
      <a class="text-link" href="/about/">Meet the company <span>↗</span></a>
    </section>

    <section class="notes section-shell section-pad">
      <div class="section-heading" data-reveal><div><p class="eyebrow">Notes from the work</p><h2>Decisions, tradeoffs, and useful detail.</h2></div><a class="text-link" href="/insights/">Read all notes <span>↗</span></a></div>
      <div class="notes-grid">
        {posts.map((post) => (
          <a class="note-card" href={`/insights/${post.id}/`} data-reveal><div><span class="eyebrow">{post.data.category}</span><span>{post.data.publishDate.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric", timeZone: "UTC" })}</span></div>{post.data.hero && <picture class="note-card__art" aria-hidden="true"><source srcset={`${post.data.hero}.avif`} type="image/avif" /><img src={`${post.data.hero}.webp`} alt="" width={post.data.heroWidth} height={post.data.heroHeight} loading="lazy" decoding="async" /></picture>}<h3>{post.data.title}</h3><p>{post.data.description}</p><span class="text-link">Read note <span>↗</span></span></a>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>
