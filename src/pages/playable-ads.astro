---
import BaseLayout from "../layouts/BaseLayout.astro";
import Scene from "../components/Scene.astro";
import GradientText from "../components/GradientText.astro";
import PlayableNav from "../components/PlayableNav.astro";
import PlayablePhone from "../components/PlayablePhone.astro";
import PlayablePlatforms from "../components/PlayablePlatforms.astro";
import PlayableDemos from "../components/PlayableDemos.astro";

const interactionSteps = [
  { state: "play", title: "Play", text: "Try a short interaction inside the ad." },
  { state: "redirect", title: "Click to redirect", text: "Tap the call to action to follow the advertised link." },
  { state: "destination", title: "Open Ad link", text: "The ad opens the configured store or landing page." },
] as const;
const workflow = [
  { title: "Shape the interaction", text: "Agree on the product moment, player action, visual direction, destination, and target ad networks before production." },
  { title: "Build the playable", text: "Create the tutorial, gameplay, feedback, result, and call to action. Add the agreed artwork, animation, sound, and variants." },
  { title: "Refine the finished experience", text: "Review the playable with you, correct issues, and check layouts, player flows, and provider packages before handoff." },
  { title: "Deliver files and a live demo", text: "Receive the agreed network packages, source files, and a browser demo link for sharing the finished creative." },
];
---

<BaseLayout title="Playable Ad Development & Live Demos | Aniloom Technologies" description="Explore Aniloom’s playable ads: live demos, concept and creative production, responsive gameplay, platform packaging, and delivery from brief to finished creative." image="/assets/images/editorial/playable-ads-v2.webp" imageAlt="Editorial illustration of a playable ad from interaction to destination." imageWidth={1400} imageHeight={1050} appearance="dark">
  <main id="main-content">
    <PlayableNav />
    <section class="page-hero page-hero--service section-shell">
      <p class="eyebrow" data-reveal>Games & Playable Experiences</p>
      <h1 data-reveal>Playable ads, from idea to <GradientText>finished creative.</GradientText></h1>
      <p class="page-hero__lead" data-reveal>Give people a short interaction with your game or product before they choose to open its link. We create the playable, refine how it feels, and deliver the files for your chosen ad networks.</p>
      <div class="page-hero__actions" data-reveal><a class="button" href="#demonstrations">Try the demos <span aria-hidden="true">↓</span></a><a class="text-link" href="/playable-ads/pricing/">View packages & pricing <span>↗</span></a></div>
    </section>

    <Scene appearance="light">
      <PlayableDemos />
      <PlayablePlatforms />
      <section class="section-shell section-pad" id="development" aria-labelledby="production-title">
        <div class="section-heading" data-reveal><div><p class="eyebrow">Full-cycle playable production</p><h2 id="production-title">Shape what people play, see, and do next.</h2></div><p>Start with your product, a reference, or an approved concept. We can connect creative direction, art, and development around one finished playable.</p></div>
        <div class="service-scope-grid">
          <article data-reveal><span>01</span><h3>Concept and game design</h3><p>Choose the product moment worth trying. Define the core interaction, tutorial, pacing, result, and reason to follow the call to action.</p></article>
          <article data-reveal><span>02</span><h3>Art, motion, and sound</h3><p>Use your approved assets or scope custom UI, 2D or 3D artwork, animation, and sound. Keep instructions readable and feedback clear on small screens.</p></article>
          <article data-reveal><span>03</span><h3>Gameplay and adaptations</h3><p>Build the interaction in HTML5/WebGL. Adapt layouts, behavioral variants, supplied translations, and analytics hooks to the agreed campaign needs.</p></article>
        </div>
      </section>
      <section class="playable-journey section-shell section-pad" aria-labelledby="playable-journey-title">
        <div class="section-heading" data-reveal><div><p class="eyebrow">How a playable ad works</p><h2 id="playable-journey-title">From interaction to destination.</h2></div><p>A playable ad lets people try a short interaction before choosing to open the advertised link.</p></div>
        <ol class="playable-journey__steps" role="list">
          {interactionSteps.map((step, index) => (
            <li class="playable-journey__step">
              <PlayablePhone state={step.state} />
              <div class="playable-journey__copy"><h3><span>{index + 1}.</span> {step.title}</h3><p>{step.text}</p></div>
              {index < interactionSteps.length - 1 && <svg class="playable-journey__arrow" aria-hidden="true" viewBox="0 0 48 24" fill="none"><path d="M2 12h42M34 2l10 10-10 10" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" /></svg>}
            </li>
          ))}
        </ol>
        <p class="playable-journey__note">Illustrated user journey. The creative, call to action, and destination are agreed in the brief.</p>
      </section>
    </Scene>

    <section class="system-band surface-dark section-pad" id="workflow">
      <div class="section-shell">
        <div class="section-heading" data-reveal><div><p class="eyebrow">From brief to delivery</p><h2>One team takes the playable through production.</h2></div><p>Creative decisions, implementation, and checks stay connected. You review the actual playable at agreed checkpoints as it takes shape.</p></div>
        <ol class="playable-workflow">
          {workflow.map((step, index) => <li data-reveal><span>0{index + 1}</span><h3>{step.title}</h3><p>{step.text}</p></li>)}
        </ol>
        <p class="system-note">The brief defines the creative and delivery requirements. The finished files and demo give your team a concrete result to review and use.</p>
      </div>
    </section>

    <Scene appearance="light">
      <section class="section-shell section-pad" id="verification" aria-labelledby="verification-title">
        <div class="section-heading" data-reveal><div><p class="eyebrow">Before handoff</p><h2 id="verification-title">Check the playable where it needs to work.</h2></div><p>We check the play experience, screen layouts, and final delivery files as part of building your playable. Issues found in our agreed production scope are corrected before handoff.</p></div>
        <div class="deliverable-grid">
          <div data-reveal><span>Portrait, landscape, and long screens</span><p>We check iPhone and iPad screen resolutions, orientation changes, and the 9:22 portrait and 22:9 landscape extremes. Instructions, artwork, and the CTA must remain visible and usable.</p></div>
          <div data-reveal><span>The full interaction and destination</span><p>We follow the tutorial, controls, feedback, result, and replay where present. The final CTA must use the correct network integration and open the agreed store or landing page.</p></div>
          <div data-reveal><span>Ad-network preview and validation</span><p>For agreed target networks, we use preview and validation tools from Google Ads, AppLovin, Liftoff, and Mintegral/Mindworks. We check single HTML files and ZIP archives, file limits, required entry files such as index.html, and click-through behavior.</p></div>
          <div data-reveal><span>Final files and a shareable demo</span><p>We deliver the HTML or ZIP package required by each selected network, together with the agreed source files. A live demo hosted on Cloudflare Workers gives your team a browser link to open and share.</p></div>
        </div>
        <p class="playable-demos__note">Preview tools check their own platform requirements. Final campaign approval belongs to the network; the package and browser coverage are agreed for your project.</p>
      </section>
      <section class="section-shell section-pad playable-faq" aria-labelledby="faq-title">
        <div class="section-heading" data-reveal><div><p class="eyebrow">Before we start</p><h2 id="faq-title">A few practical details.</h2></div><p>Scope, review dates, delivery requirements, and responsibilities are agreed before paid work begins.</p></div>
        <details><summary>What do we need to provide?</summary><p>Share your game or product, concept or reference, available brand and product assets, required copy, target networks, destination link, and deadline. We agree on creative production and any missing inputs before starting.</p></details>
        <details><summary>Can you create the artwork and additional versions?</summary><p>Yes. We can scope custom UI, 2D or 3D assets, animation, behavioral variants, supplied translations, and additional network packages. The pricing page explains the base package and optional production work.</p></details>
        <details><summary>How do we review the playable?</summary><p>Open the live demo link in your browser at agreed checkpoints. Review the interaction and presentation, then share feedback for the next production round. We check the final network files separately from the hosted demo.</p></details>
        <details><summary>What do we receive at handoff?</summary><p>The finished playable in the agreed ad-network formats, source files, and a live demo link. Exact networks, versions, review rounds, and delivery dates are defined in your proposal.</p></details>
      </section>
    </Scene>
    <section class="callout surface-dark section-shell section-pad"><p class="eyebrow">Start a conversation</p><h2>Plan your playable.</h2><p>Explore the base development package, optional creative production, and adaptations. Share your idea when you are ready to define the scope.</p><div class="callout__actions"><a class="text-link" href="/playable-ads/pricing/">See scope & pricing <span>↗</span></a><a class="button" href="/contact/">Discuss a playable</a></div></section>
  </main>
</BaseLayout>
