---
import BaseLayout from "../layouts/BaseLayout.astro";
import GradientText from "../components/GradientText.astro";
import PlayableNav from "../components/PlayableNav.astro";
---

<BaseLayout title="Playable Ads | Development, QA, and Release Readiness | Aniloom Technologies" description="HTML5 playable ad development and QA for existing builds. Explore production packages, release-readiness reviews, pricing, and working demonstrations." image="/assets/images/editorial/playable-ads-v2.webp" imageAlt="Editorial illustration of playable-ad interaction states and release readiness." imageWidth={1400} imageHeight={1050}>
  <main id="main-content">
    <PlayableNav />
    <section class="page-hero page-hero--service section-shell">
      <p class="eyebrow" data-reveal>Games & Playable Experiences</p>
      <h1 data-reveal>Playable ad development and <GradientText>release testing.</GradientText></h1>
      <p class="page-hero__lead" data-reveal>We build HTML5/WebGL playable ads and test existing builds before launch. Choose development for a new creative or QA for a playable you already have.</p>
      <div class="page-hero__actions" data-reveal><button class="button" type="button" data-contact-open>Discuss a playable</button><a class="text-link" href="/playable-ads/pricing/">View packages & pricing <span>↗</span></a></div>
    </section>

    <figure class="service-artwork section-shell" data-reveal>
      <picture>
        <source srcset="/assets/images/editorial/playable-ads-v2.avif" type="image/avif" />
        <img src="/assets/images/editorial/playable-ads-v2.webp" alt="An editorial sequence of interactive states connected by a cyan path, with a yellow decision point marking the intended action before review and release." width="1400" height="1050" loading="lazy" decoding="async" />
      </picture>
    </figure>

    <section class="entry-points section-shell section-pad" id="choose-path">
      <div class="section-heading" data-reveal><div><p class="eyebrow">Choose your service</p><h2>Build a new playable or test an existing one.</h2></div><p>Development includes implementation and release-quality review. The QA package covers testing and one retest; engineering fixes are scoped separately.</p></div>
      <div class="path-grid">
        <a class="path-card" href="/playable-ads/development/" data-reveal><span>01 / Development</span><h2>We need a playable built.</h2><p>Build a playable from your brief or reference, with responsive layouts, agreed interactions, QA, and a production handoff.</p><strong>Explore development <i>↗</i></strong></a>
        <a class="path-card" href="/playable-ads/qa-release-readiness/" data-reveal><span>02 / QA & Release</span><h2>We have a playable to review.</h2><p>Test the interaction, portrait and landscape layouts, agreed variants, and package requirements. Receive prioritized findings and a release-readiness summary.</p><strong>Explore QA & release readiness <i>↗</i></strong></a>
      </div>
    </section>

    <section class="system-band section-pad">
      <div class="section-shell">
        <div class="section-heading" data-reveal><div><p class="eyebrow">Aniloom Playable Quality System</p><h2>Developers and QA review the same interactions.</h2></div><p>Our workflow connects implementation, visual checks, user-journey testing, issue tracking, and retest.</p></div>
        <div class="system-flow" data-reveal><span>Brief</span><i></i><span>Build</span><i></i><span>Test</span><i></i><span>Retest</span><i></i><span>Release summary</span></div>
        <div class="system-actions" data-reveal><a class="text-link" href="/playable-ads/how-we-work/">See the complete workflow <span>↗</span></a><p class="system-note">The workflow supports an informed release decision. Platform acceptance and campaign results depend on factors outside our delivery scope.</p></div>
      </div>
    </section>

    <section class="deliverable section-shell section-pad">
      <div class="section-heading" data-reveal><div><p class="eyebrow">What we check</p><h2>Interaction, layout, and delivery requirements.</h2></div><p>Your brief and target specifications determine the checks and deliverables included in the proposal.</p></div>
      <div class="deliverable-grid">
        <div data-reveal><span>User journey</span><p>Instructions, core interaction, feedback, result screen, and click-through action.</p></div>
        <div data-reveal><span>Responsive experience</span><p>Layout, scale, fonts, hierarchy, controls, and important states across portrait and landscape.</p></div>
        <div data-reveal><span>Variants and platforms</span><p>Agreed format constraints, integrations, links, end cards, localization, and environment-specific behavior.</p></div>
        <div data-reveal><span>Findings and retest</span><p>Issues with reproduction steps, correction status, retest results, and remaining release risks.</p></div>
      </div>
    </section>

    <section class="service-crosslink section-shell" data-reveal><p class="eyebrow">Public demonstrations</p><div><h2>Try three playable demos.</h2><a class="text-link" href="/playable-ads/case-studies/magic-thai-playables/">Try the Magic Thai playables <span>↗</span></a></div></section>

    <section class="callout section-shell section-pad" data-reveal><p class="eyebrow">Start a conversation</p><h2>Bring the brief or the build.</h2><p>Share your brief or playable, target ad-network specifications, available assets, and deadline. We will recommend a development or QA package.</p><div class="callout__actions"><a class="text-link" href="/playable-ads/release-quality-platform-readiness/">See the readiness package <span>↗</span></a><button class="button" type="button" data-contact-open>Discuss a playable</button></div></section>
  </main>
</BaseLayout>
