---
import BaseLayout from "../layouts/BaseLayout.astro";
import Scene from "../components/Scene.astro";
import GradientText from "../components/GradientText.astro";
import PlayableNav from "../components/PlayableNav.astro";
import PlayablePhone from "../components/PlayablePhone.astro";
import PlayablePlatforms from "../components/PlayablePlatforms.astro";
import PlayableDemos from "../components/PlayableDemos.astro";

const interactionSteps = [
  { state: "play", title: "Play", text: "Try a short interaction inside the ad." },
  { state: "redirect", title: "Click to redirect", text: "Tap the call to action to follow the advertised link." },
  { state: "destination", title: "Open Ad link", text: "The ad opens the configured store or landing page." },
] as const;
const workflow = [
  { title: "Agree on the brief", text: "Confirm the interaction or current build, assets, target provider, review points, and acceptance criteria." },
  { title: "Build or review", text: "For development, we implement the playable and test during production. For QA, we review your stable build and document findings." },
  { title: "Correct and retest", text: "Engineering makes the agreed corrections. QA rechecks changed interactions, layouts, and variants; the QA package includes one retest." },
  { title: "Receive the handoff", text: "Development delivers production files and source. QA delivers findings, retest results, coverage gaps, and remaining release risks." },
];
---

<BaseLayout title="Playable Ads | Development, Demos & QA | Aniloom Technologies" description="Try Aniloom's playable ad demos. Explore HTML5/WebGL development from $5,000, existing-build QA from $1,500, and a connected delivery workflow." image="/assets/images/editorial/playable-ads-v2.webp" imageAlt="Editorial illustration of playable-ad interaction states and release readiness." imageWidth={1400} imageHeight={1050} appearance="dark">
  <main id="main-content">
    <PlayableNav />
    <section class="page-hero page-hero--service section-shell">
      <p class="eyebrow" data-reveal>Games & Playable Experiences</p>
      <h1 data-reveal>Playable ad development and <GradientText>release testing.</GradientText></h1>
      <p class="page-hero__lead" data-reveal>We build HTML5/WebGL playable ads and test existing builds before launch. Try our work, then choose development for a new creative or QA for a playable you already have.</p>
      <div class="page-hero__actions" data-reveal><a class="button" href="#demonstrations">Try the demos <span aria-hidden="true">↓</span></a><a class="text-link" href="/playable-ads/pricing/">View packages & pricing <span>↗</span></a></div>
    </section>

    <Scene appearance="light">
      <PlayableDemos />
      <PlayablePlatforms />
      <section class="section-shell section-pad" id="services" aria-labelledby="services-title">
        <div class="section-heading" data-reveal><div><p class="eyebrow">Choose your starting point</p><h2 id="services-title">Build a new playable or test an existing one.</h2></div><p>Both paths cover the user journey and portrait and landscape layouts. The package defines the variants, provider requirements, and handoff.</p></div>
        <div class="playable-service-grid">
          <article class="playable-service" id="development" data-reveal>
            <p class="eyebrow">Development</p><h3>A new playable, ready for handoff.</h3>
            <p>Turn your approved concept or reference into one core interaction, from tutorial and gameplay to the result and call to action.</p>
            <ul class="clean-list"><li>HTML5/WebGL implementation using your approved assets</li><li>Portrait and landscape, one language, one behavioral variant</li><li>One provider package, two review rounds, and release-quality review</li><li>Production files and source handoff</li></ul>
            <p class="playable-service__price">From <strong>$5,000 USD</strong> · Plan for 10–15 business days</p>
            <p class="playable-service__note">After complete inputs and access. Custom art, substantial animation, and additional adaptations are add-ons.</p>
            <a class="text-link" href="/playable-ads/pricing/#development-package">See development scope & pricing <span>↗</span></a>
          </article>
          <article class="playable-service" id="qa-release-readiness" data-reveal>
            <p class="eyebrow">QA & release readiness</p><h3>A clear review of your existing build.</h3>
            <p>Test instructions, controls, feedback, result screens, click-through behavior, responsive layouts, and the agreed provider package.</p>
            <ul class="clean-list"><li>One stable playable in portrait and landscape</li><li>Up to two behavioral variants and one provider package</li><li>Prioritized findings with reproduction context and evidence</li><li>One retest after corrections and a release-readiness summary</li></ul>
            <p class="playable-service__price">From <strong>$1,500 USD</strong> · Plan for 3–5 business days</p>
            <p class="playable-service__note">After stable-build access. Engineering fixes are separate scope; your developers correct the build or we agree on a correction sprint.</p>
            <a class="text-link" href="/playable-ads/pricing/#readiness-package">See QA scope & pricing <span>↗</span></a>
          </article>
        </div>
        <p class="playable-demos__note">Planning ranges are confirmed in the proposal. Prices are in USD before applicable taxes.</p>
      </section>
      <section class="playable-journey section-shell section-pad" aria-labelledby="playable-journey-title">
        <div class="section-heading" data-reveal><div><p class="eyebrow">How a playable ad works</p><h2 id="playable-journey-title">From interaction to destination.</h2></div><p>A playable ad lets people try a short interaction before choosing to open the advertised link.</p></div>
        <ol class="playable-journey__steps" role="list">
          {interactionSteps.map((step, index) => (
            <li class="playable-journey__step">
              <PlayablePhone state={step.state} />
              <div class="playable-journey__copy"><h3><span>{index + 1}.</span> {step.title}</h3><p>{step.text}</p></div>
              {index < interactionSteps.length - 1 && <svg class="playable-journey__arrow" aria-hidden="true" viewBox="0 0 48 24" fill="none"><path d="M2 12h42M34 2l10 10-10 10" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" /></svg>}
            </li>
          ))}
        </ol>
        <p class="playable-journey__note">Illustrated user journey. The creative, call to action, and destination are agreed in the brief.</p>
      </section>
    </Scene>

    <section class="system-band surface-dark section-pad" id="workflow">
      <div class="section-shell">
        <div class="section-heading" data-reveal><div><p class="eyebrow">Aniloom Playable Quality System</p><h2>One brief, connected development and QA.</h2></div><p>Developers and QA use the same acceptance criteria. Olena leads the Quality Engineering practice and its review standards.</p></div>
        <ol class="playable-workflow">
          {workflow.map((step, index) => <li data-reveal><span>0{index + 1}</span><h3>{step.title}</h3><p>{step.text}</p></li>)}
        </ol>
        <p class="system-note">You provide inputs and feedback at agreed checkpoints. The client owns the final release decision unless the agreement assigns it differently.</p>
      </div>
    </section>

    <Scene appearance="light">
      <section class="section-shell section-pad playable-faq" aria-labelledby="faq-title">
        <div class="section-heading" data-reveal><div><p class="eyebrow">Before we start</p><h2 id="faq-title">A few practical details.</h2></div><p>Scope, review dates, delivery requirements, and responsibilities are agreed before paid work begins.</p></div>
        <details><summary>What do we need to provide?</summary><p>For development, share an approved concept or reference, product and brand assets, required copy, target provider specification, destination link, analytics requirements, and a decision-maker. For QA, share stable-build access, variants, the provider specification, known issues, and your deadline.</p></details>
        <details><summary>Can you create art or adapt a playable for more networks?</summary><p>Yes. Custom UI, 2D or 3D asset work, substantial animation, additional behavioral variants, client-supplied localization, and extra provider packages can be scoped as add-ons. The base development package uses your approved assets.</p></details>
        <details><summary>Does QA include fixing the playable?</summary><p>The QA package includes findings and one retest after corrections. Your development team makes the fixes, or Aniloom scopes a separate Correction & Retest Sprint. Development projects include technical corrections within their agreed scope.</p></details>
        <details><summary>What does release readiness mean?</summary><p>A record of what was tested, open issues, blocked checks, and remaining risks to support your release decision. It is not certification or a guarantee of advertising-platform acceptance, campaign performance, or a defect-free release.</p></details>
      </section>
    </Scene>
    <section class="callout surface-dark section-shell section-pad"><p class="eyebrow">Start a conversation</p><h2>Bring the brief or the build.</h2><p>Share your brief or playable, target ad-network specifications, available assets, and deadline. We will recommend a development or QA package.</p><div class="callout__actions"><a class="text-link" href="/playable-ads/pricing/">Compare packages & pricing <span>↗</span></a><a class="button" href="/contact/">Discuss a playable</a></div></section>
  </main>
</BaseLayout>
