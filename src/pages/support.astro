---
import "../styles/global.css";
---

<!doctype html>
<html lang="en" data-appearance="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Email support for Aniloom applications." />
    <title>Support | Aniloom Technologies</title>
    <link rel="canonical" href="https://aniloom.tech/support/" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
  </head>
  <body>
    <main>
      <div class="support-contact">
        <span class="support-email">support@aniloom.tech</span>
        <button type="button" class="button button--secondary" data-copy-email hidden>Copy email</button>
        <p data-copy-status role="status" aria-live="polite" aria-atomic="true"></p>
      </div>
    </main>
    <script src="/assets/js/email-copy.js" defer></script>
  </body>
</html>

<style>
  main { min-height: 100svh; display: grid; place-items: center; padding: 1.5rem; }
  .support-contact { display: flex; flex-direction: column; align-items: center; gap: 1.25rem; text-align: center; max-width: 100%; }
  .support-email { font-size: clamp(1.125rem, 4vw, 1.75rem); color: var(--text); user-select: all; overflow-wrap: anywhere; }
  [data-copy-status] { min-height: 1.55em; margin: 0; font-size: .875rem; }
</style>
