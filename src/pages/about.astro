---
import BaseLayout from "../layouts/BaseLayout.astro";
import GradientText from "../components/GradientText.astro";
---

<BaseLayout title="About Aniloom | Company and Leadership | Aniloom Technologies" description="Meet Ino, Olena, and Oleksandr, the people leading Aniloom's company direction, technology, Quality Engineering, and delivery workflows.">
  <main id="main-content">
    <section class="page-hero section-shell">
      <p class="eyebrow" data-reveal>About Aniloom</p>
      <h1 data-reveal>The people behind <GradientText>Aniloom.</GradientText></h1>
      <p class="page-hero__lead" data-reveal>Aniloom Technologies brings software development, design, and testing together for studios, startups, and product teams that need specialist expertise.</p>
    </section>

    <figure class="visual-story about-collaboration section-shell" data-reveal>
      <picture>
        <source srcset="/assets/images/editorial/collaborative-prototype-review.avif" type="image/avif" />
        <img src="/assets/images/editorial/collaborative-prototype-review.webp" alt="Illustration of collaborators discussing paper interface prototypes and making notes around a table." width="2172" height="724" loading="lazy" decoding="async" />
      </picture>
      <figcaption><span>Shared product review</span><p>An illustration of product decisions taking shape through discussion.</p></figcaption>
    </figure>

    <section class="leadership section-shell section-pad">
      <div class="section-heading" data-reveal><div><p class="eyebrow">Leadership</p><h2>Who leads the work.</h2></div><p>Company direction, technical decisions, and release quality each have a clear owner. Meet the people responsible for them.</p></div>
      <div class="leadership-grid">
        <article class="leadership-card leadership-card--text" data-reveal>
          <div><p class="eyebrow">Founder & CEO</p><h2>Ino</h2><p>Ino leads company direction, major client relationships, and decisions about how Aniloom approaches a project. He brings more than 10 years of professional experience in game development.</p></div>
        </article>
        <article class="leadership-card leadership-card--text" data-reveal>
          <div><p class="eyebrow">Co-Founder & COO</p><h2>Olena</h2><p>Olena leads Aniloom’s Quality Engineering practice and designs the systems, standards, and delivery workflows used by the team.</p></div>
        </article>
        <article class="leadership-card leadership-card--cto" data-reveal>
          <figure class="leadership-card__media">
            <picture><img src="/assets/team/oleksandr-mushnykov-studio-portrait.webp" alt="Oleksandr Mushnykov" width="800" height="800" loading="lazy" decoding="async" /></picture>
          </figure>
          <div><p class="eyebrow">CTO</p><h2>Oleksandr Mushnykov</h2><p>Oleksandr leads Aniloom's technology direction, overseeing architecture, infrastructure, and key technical decisions. He brings experience in game development, server systems, custom CMS development, and DevOps to help the team solve complex engineering challenges.</p></div>
        </article>
      </div>
    </section>

    <section class="callout surface-dark section-shell section-pad">
      <p class="eyebrow">Working with Aniloom</p>
      <h2>Tell us what you want to build or improve.</h2>
      <p>Share your goal, what already exists, and your target timeline. We will discuss the expertise you need and a practical next step.</p>
      <a class="button" href="/contact/">Discuss your project</a>
    </section>
  </main>
</BaseLayout>

<style>
  .about-collaboration picture { aspect-ratio: 3 / 1; }
  .leadership-card--cto { grid-column: 1 / -1; grid-template-columns: minmax(180px, 240px) minmax(0, 1fr); min-height: 0; align-items: center; }
  .leadership-card--cto .leadership-card__media picture { flex: initial; min-height: 0; aspect-ratio: 1; }
  .leadership-card--cto h2 { overflow-wrap: anywhere; }
  @media (max-width: 600px) {
    .about-collaboration picture { aspect-ratio: 2 / 1; }
    .leadership-card--cto { grid-template-columns: minmax(0, 1fr); }
    .leadership-card--cto .leadership-card__media { width: 100%; max-width: 280px; }
  }
</style>
