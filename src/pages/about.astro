---
import BaseLayout from "../layouts/BaseLayout.astro";
import GradientText from "../components/GradientText.astro";
import Scene from "../components/Scene.astro";
---

<BaseLayout appearance="dark" title="About Aniloom | Our Story and Leadership | Aniloom Technologies" description="Learn why Ino and Olena built Aniloom, how we work as product partners, and who leads our technology, Quality Engineering, and delivery.">
  <main id="main-content">
    <Scene appearance="dark">
      <section class="about-intro section-shell">
        <p class="eyebrow" data-reveal>About Aniloom</p>
        <div class="about-intro__grid">
          <h1 data-reveal>The people behind <GradientText>Aniloom.</GradientText></h1>
          <div class="about-intro__copy" data-reveal>
            <p>Ino had long wanted to build a company of his own. He and Olena each bring more than ten years in tech. They founded Aniloom Technologies to shape a service around their experience and the client's goal.</p>
            <p>We work as partners with a shared interest in the product's success. We invest time in research and conversation to understand what you actually need before planning the work.</p>
            <p>We use AI where it can save time without compromising quality. People remain responsible for the decisions, review, and result we deliver.</p>
          </div>
        </div>
      </section>
    </Scene>

    <Scene appearance="light">
      <figure class="about-collaboration">
        <picture>
          <source srcset="/assets/images/editorial/collaborative-prototype-review.avif" type="image/avif" />
          <img src="/assets/images/editorial/collaborative-prototype-review.webp" alt="Illustration of collaborators discussing paper interface prototypes and making notes around a table." width="2172" height="724" loading="lazy" decoding="async" />
        </picture>
        <figcaption class="section-shell">An illustration of product decisions taking shape through discussion.</figcaption>
      </figure>

    <section class="leadership section-shell section-pad">
      <div class="section-heading" data-reveal><div><p class="eyebrow">Leadership</p><h2>Who leads the work.</h2></div><p>Company direction, technical decisions, and release quality each have a clear owner. Meet the people responsible for them.</p></div>
      <div class="leadership-grid">
        <article class="leadership-card leadership-card--text" data-reveal>
          <div><p class="eyebrow">Founder & CEO</p><h2>Ino</h2><p>Ino leads company direction, major client relationships, and decisions about how Aniloom approaches a project. He brings more than 10 years of professional experience in game development.</p></div>
        </article>
        <article class="leadership-card leadership-card--portrait" data-reveal>
          <figure class="leadership-card__media">
            <picture><img src="/assets/team/olena-portrait.webp" alt="Olena" width="800" height="800" loading="lazy" decoding="async" /></picture>
          </figure>
          <div><p class="eyebrow">Co-Founder & COO</p><h2>Olena</h2><p>Olena leads Aniloom’s Quality Engineering practice and designs the systems, standards, and delivery workflows used by the team.</p></div>
        </article>
        <article class="leadership-card leadership-card--cto" data-reveal>
          <figure class="leadership-card__media">
            <picture><img src="/assets/team/oleksandr-mushnykov-studio-portrait.webp" alt="Alex" width="800" height="800" loading="lazy" decoding="async" /></picture>
          </figure>
          <div><p class="eyebrow">CTO</p><h2>Alex</h2><p>Alex leads Aniloom's technology direction, overseeing architecture, infrastructure, and key technical decisions. He brings experience in game development, server systems, custom CMS development, and DevOps to help the team solve complex engineering challenges.</p></div>
        </article>
      </div>
    </section>

    </Scene>

    <section class="callout surface-dark section-shell section-pad">
      <p class="eyebrow">Working with Aniloom</p>
      <h2>Tell us what you want to build or improve.</h2>
      <p>Share your goal, what already exists, and your target timeline. We will discuss the expertise you need and a practical next step.</p>
      <a class="button" href="/contact/">Discuss your project</a>
    </section>
  </main>
</BaseLayout>

<style>
  .about-intro { padding-block: clamp(120px, 10vw, 160px) clamp(56px, 6vw, 88px); }
  .about-intro > .eyebrow { margin-bottom: 24px; }
  .about-intro__grid { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: clamp(40px, 6vw, 88px); align-items: start; }
  .about-intro h1 { margin: 0; font-size: clamp(3.2rem, 6.3vw, 6.6rem); font-weight: 500; }
  .about-intro__copy { max-width: 62ch; }
  .about-intro__copy p { margin: 0 0 20px; }
  .about-intro__copy p:last-child { margin-bottom: 0; }
  .about-collaboration { margin: 0; }
  .about-collaboration picture { display: block; width: 100%; aspect-ratio: 3 / 1; overflow: hidden; }
  .about-collaboration img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .about-collaboration figcaption { padding-block: 14px 0; color: var(--quiet); font-size: .75rem; }
  .leadership { padding-block: clamp(56px, 6vw, 88px); }
  .leadership .section-heading { margin-bottom: clamp(32px, 4vw, 56px); }
  .leadership-card--portrait { grid-template-columns: minmax(160px, 200px) minmax(0, 1fr); gap: 28px; min-height: 0; align-items: center; }
  .leadership-card--portrait .leadership-card__media picture { flex: initial; min-height: 0; aspect-ratio: 1; }
  .leadership-card--cto { grid-column: 1 / -1; grid-template-columns: minmax(180px, 240px) minmax(0, 1fr); min-height: 0; align-items: center; }
  .leadership-card--cto .leadership-card__media picture { flex: initial; min-height: 0; aspect-ratio: 1; }
  .leadership-card--cto h2 { overflow-wrap: anywhere; }
  @media (max-width: 900px) {
    .about-intro__grid { grid-template-columns: minmax(0, 1fr); gap: 28px; }
  }
  @media (max-width: 600px) {
    .about-intro { padding-block: 112px 48px; }
    .about-intro h1 { font-size: clamp(2.7rem, 11vw, 4rem); }
    .about-collaboration picture { aspect-ratio: 2 / 1; }
    .leadership-card--portrait { grid-template-columns: minmax(0, 1fr); }
    .leadership-card--portrait .leadership-card__media { width: 100%; max-width: 280px; }
    .leadership-card--cto { grid-template-columns: minmax(0, 1fr); }
    .leadership-card--cto .leadership-card__media { width: 100%; max-width: 280px; }
  }
</style>
