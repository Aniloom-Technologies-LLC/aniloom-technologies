---
import BaseLayout from "../layouts/BaseLayout.astro";
import GradientText from "../components/GradientText.astro";

const models = [
  { number: "01", title: "Managed Project Delivery", text: "For a new build, a defined improvement, or project recovery. We agree on deliverables, review points, and a delivery timeline, then manage the work." },
  { number: "02", title: "Monthly Development & Support", text: "For regular development, testing, maintenance, or design support. The agreement defines the work covered, review schedule, and support level." },
  { number: "03", title: "Discovery & Specialist Consulting", text: "For a project that needs a specification, architecture, prototype, or detailed plan before development. These deliverables are scoped as a separate paid milestone." },
  { number: "04", title: "White-label Delivery", text: "For partners delivering work under their own brand. We agree on scope, ownership, confidentiality, and handoff requirements before production." },
];
---

<BaseLayout title="How We Work | Aniloom Technologies" description="Learn how Aniloom structures managed project delivery, ongoing development, discovery, and white-label engagements.">
  <main id="main-content">
    <section class="page-hero section-shell">
      <p class="eyebrow" data-reveal>How we work</p>
      <h1 data-reveal>From project brief to <GradientText>delivery.</GradientText></h1>
      <p class="page-hero__lead" data-reveal>You set the goal and review the work. Aniloom manages planning, specialist coordination, and delivery against the scope and timeline we agree together.</p>
    </section>

    <section class="model-grid section-shell section-pad">
      {models.map((model) => (
        <article class="model-card" data-reveal><span>{model.number}</span><h2>{model.title}</h2><p>{model.text}</p></article>
      ))}
    </section>

    <section class="process surface-dark process--page section-pad">
      <div class="section-shell">
        <div class="section-heading" data-reveal><div><p class="eyebrow">Project steps</p><h2>What you provide and what we deliver.</h2></div><p>The proposal defines the inputs, review schedule, deliverables, and responsibilities for your project.</p></div>
        <ol class="process-grid process-grid--four">
          <li data-reveal><span>01</span><h3>Share the inputs</h3><p>Provide the brief or current build, available assets, access requirements, known constraints, and target timeline.</p></li>
          <li data-reveal><span>02</span><h3>Agree on the scope</h3><p>We define deliverables, acceptance criteria, review dates, and client dependencies. Aniloom manages staffing and tools.</p></li>
          <li data-reveal><span>03</span><h3>Review working builds</h3><p>We deliver builds or review findings on the agreed schedule. You provide feedback and decisions at the planned checkpoints.</p></li>
          <li data-reveal><span>04</span><h3>Receive the handoff</h3><p>Receive the agreed build, source files, reports, or documentation. We identify remaining risks and any separately scoped follow-up work.</p></li>
        </ol>
      </div>
    </section>

    <section class="service-crosslink section-shell" data-reveal>
      <p class="eyebrow">Playable-specific workflow</p>
      <div><h2>See how development and QA connect for playable ads.</h2><a class="text-link" href="/playable-ads/how-we-work/">Explore the Aniloom Playable Quality System <span>↗</span></a></div>
    </section>

    <section class="entry-points section-shell section-pad">
      <div class="section-heading" data-reveal><div><p class="eyebrow">After you contact us</p><h2>Start with a project conversation.</h2></div><p>We discuss fit and suggest a next step. If detailed discovery is needed, we agree on its scope and price before starting.</p></div>
      <div class="entry-grid">
        <article data-reveal><span>01</span><h2>Tell us about the project</h2><p>Share what you want to build or improve, what already exists, and your budget and target timeline.</p></article>
        <article data-reveal><span>02</span><h2>Choose the engagement</h2><p>We recommend a project, ongoing support, or discovery based on the work and the inputs available.</p></article>
        <article data-reveal><span>03</span><h2>Agree on the next step</h2><p>The proposal confirms scope, deliverables, price, schedule, and responsibilities before paid work begins.</p></article>
      </div>
    </section>

    <section class="callout surface-dark section-shell section-pad">
      <p class="eyebrow">AI and accountability</p>
      <h2>Use better tools.<br />Keep people responsible.</h2>
      <p>AI can help us explore more options, accelerate production, and improve parts of the workflow. Experienced people still define intent, evaluate the result, and remain responsible for decisions and release.</p>
      <button class="button" type="button" data-contact-open>Discuss your project</button>
    </section>
  </main>
</BaseLayout>
