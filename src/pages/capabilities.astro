---
import BaseLayout from "../layouts/BaseLayout.astro";
import GradientText from "../components/GradientText.astro";

const groups = [
  { id: "product-engineering", number: "01", title: "Product Engineering", lead: "Develop a new website or application, continue an existing product, or recover unfinished work.", fit: "A fit for teams planning a build, adding features, or taking over a stalled project.", items: ["Websites and web applications", "Mobile applications", "Internal tools", "Product recovery and continuation", "Ongoing development and support"] },
  { id: "games-playables", number: "02", title: "Games & Playable Experiences", lead: "Build Unity games, browser games, and playable ads, with design, art, and testing included as scoped.", fit: "A fit for studios and product teams developing a game or interactive experience. Playable Ads has dedicated development and QA packages.", href: "/playable-ads/", cta: "Explore Playable Ads", items: ["Unity game development", "HTML5 / WebGL browser games", "Playable ads and microgames", "Gamification", "Game-supporting digital experiences"] },
  { id: "quality-engineering", number: "03", title: "Quality Engineering & Testing", lead: "Test critical user journeys, identify defects, and document what is ready for release and what needs attention.", fit: "A fit for teams checking a release, adding regular QA support, or setting up a reusable testing process.", href: "/quality-engineering/", cta: "Explore Quality Engineering", items: ["Functional and regression testing", "Build and release testing", "Performance and compatibility review", "UX and design-quality review", "Test automation where appropriate"] },
  { id: "design-art", number: "04", title: "Design & Art", lead: "Create interfaces, visual assets, characters, and animation that fit the product and its implementation.", fit: "A fit for teams that need UI/UX or art production as part of a build or a defined specialist project.", items: ["UI/UX", "Visual direction", "2D and 3D production", "Character sculpting and modeling", "Animation for Unity and web"] },
];
---

<BaseLayout title="Capabilities | Aniloom Technologies" description="Explore Aniloom capabilities across product engineering, games and playable experiences, quality engineering, design, and art.">
  <main id="main-content">
    <section class="page-hero section-shell">
      <p class="eyebrow" data-reveal>Capabilities</p>
      <h1 data-reveal>The expertise your product needs <GradientText>next.</GradientText></h1>
      <p class="page-hero__lead" data-reveal>Choose the work your product needs: a new build, continued development, release testing, or design and art production. We manage the scope and bring together the required expertise.</p>
    </section>

    <figure class="visual-story visual-story--detail section-shell" data-reveal>
      <picture>
        <source srcset="/assets/images/editorial/product-flow-review.avif" type="image/avif" />
        <img src="/assets/images/editorial/product-flow-review.webp" alt="Illustration of hands comparing a printed product flow with a block-layout study on a tablet." width="1360" height="1020" loading="lazy" decoding="async" />
      </picture>
      <figcaption>Illustration of product-flow review.</figcaption>
    </figure>

    <section class="capability-list section-shell section-pad">
      {groups.map((group) => (
        <article class="capability-detail" id={group.id} data-reveal>
          <span class="capability-detail__number">{group.number}</span>
          <div><h2>{group.title}</h2><p class="capability-detail__lead">{group.lead}</p><p class="capability-detail__fit">{group.fit}</p>{group.href && <a class="text-link" href={group.href}>{group.cta} <span>↗</span></a>}</div>
          <ul class="clean-list">{group.items.map((item) => <li>{item}</li>)}</ul>
        </article>
      ))}
    </section>

    <section class="callout section-shell section-pad" data-reveal>
      <p class="eyebrow">Project or ongoing support</p>
      <h2>Choose how to work with us.</h2>
      <p>Engage Aniloom for a defined project, monthly development and support, or discovery before a larger build. We agree on deliverables and a schedule for the work.</p>
      <div class="callout__actions"><a class="text-link" href="/how-we-work/">See engagement models <span>↗</span></a><button class="button" type="button" data-contact-open>Discuss your project</button></div>
    </section>
  </main>
</BaseLayout>
