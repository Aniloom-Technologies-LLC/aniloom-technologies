---
import BaseLayout from "../layouts/BaseLayout.astro";
import GradientText from "../components/GradientText.astro";

const groups = [
  { id: "product-engineering", number: "01", title: "Product Engineering", lead: "Build, continue, or recover a digital product around the state your team needs to reach.", items: ["Websites and web applications", "Mobile applications", "Internal tools", "Product recovery and continuation", "Ongoing development and support"] },
  { id: "games-playables", number: "02", title: "Games & Playable Experiences", lead: "Interactive products that connect game thinking, technical execution, and the experience of the player or customer.", items: ["Unity game development", "HTML5 / WebGL browser games", "Playable ads and microgames", "Gamification", "Game-supporting digital experiences"] },
  { id: "quality-engineering", number: "03", title: "Quality Engineering & Testing", lead: "Make product risk, tested areas, open defects, and release readiness visible before consequential decisions.", items: ["Functional and regression testing", "Build and release testing", "Performance and compatibility review", "UX and design-quality review", "Test automation where appropriate"] },
  { id: "design-art", number: "04", title: "Design & Art", lead: "Connect interface, visual direction, assets, and animation to the way the product is built and used.", items: ["UI/UX", "Visual direction", "2D and 3D production", "Character sculpting and modeling", "Animation for Unity and web"] },
];
---

<BaseLayout title="Capabilities | Aniloom Technologies" description="Explore Aniloom capabilities across product engineering, games and playable experiences, quality engineering, design, and art.">
  <main id="main-content">
    <section class="page-hero section-shell">
      <p class="eyebrow" data-reveal>Capabilities</p>
      <h1 data-reveal>The expertise your product needs <GradientText>next.</GradientText></h1>
      <p class="page-hero__lead" data-reveal>We connect technical, quality, and creative disciplines around a defined product goal. Scope can cover a complete build, a missing capability, or a product that needs to move again.</p>
    </section>

    <section class="capability-list section-shell section-pad">
      {groups.map((group) => (
        <article class="capability-detail" id={group.id} data-reveal>
          <span class="capability-detail__number">{group.number}</span>
          <div><h2>{group.title}</h2><p class="capability-detail__lead">{group.lead}</p></div>
          <ul class="clean-list">{group.items.map((item) => <li>{item}</li>)}</ul>
        </article>
      ))}
    </section>

    <section class="callout section-shell section-pad" data-reveal>
      <p class="eyebrow">The boundary matters</p>
      <h2>Tools explain how we work.<br />They do not define what you buy.</h2>
      <p>Unity, HTML5/WebGL, AI, Blender, Maya, and other technologies support the work. The engagement stays organized around the product state, release, or cadence your team needs.</p>
      <div class="callout__actions"><a class="text-link" href="/how-we-work/">See engagement models <span>↗</span></a><button class="button" type="button" data-contact-open>Discuss your project</button></div>
    </section>
  </main>
</BaseLayout>
