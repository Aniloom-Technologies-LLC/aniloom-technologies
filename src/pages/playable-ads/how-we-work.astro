---
import BaseLayout from "../../layouts/BaseLayout.astro";
import GradientText from "../../components/GradientText.astro";
import PlayableNav from "../../components/PlayableNav.astro";

const steps = [
  { number: "01", title: "Intake and target", text: "Collect the brief or current build, target environments, variants, deadline, assets, known constraints, and the decision the work must support." },
  { number: "02", title: "Risk map and criteria", text: "Identify the failures that would matter most, clarify acceptance criteria, and define the meaningful objects, states, and configurations to review." },
  { number: "03", title: "Visual-state review", text: "Check layout, scale, fonts, controls, hierarchy, animation states, cropping, and content across the experience rather than only at launch." },
  { number: "04", title: "Portrait and landscape", text: "Review representative viewport sizes, orientation-specific behavior, safe areas, readability, reach, and the states where responsive problems can hide." },
  { number: "05", title: "End-user journey", text: "Follow the interaction from entry through progression, feedback, call to action, end card, outbound link, replay, and relevant failure paths." },
  { number: "06", title: "Variant and platform readiness", text: "Check agreed creative or localization variants, packaging, integration behavior, target-environment constraints, and any known limitations." },
  { number: "07", title: "Saved correction", text: "Record issues with context and evidence. Engineering implements technical changes; suitable projects may use internal tooling to save responsive corrections." },
  { number: "08", title: "Regression and retest", text: "Recheck corrected states, related flows, orientations, and variants so the change does not quietly move the problem elsewhere." },
  { number: "09", title: "Release disposition", text: "Summarize reviewed scope, passed areas, open defects, blocked checks, accepted risks, owners, and the remaining release decision." },
];
---

<BaseLayout title="How Playable Ads Work | Aniloom Technologies" description="The Aniloom Playable Quality System from intake and risk mapping through responsive review, correction, retest, and release disposition.">
  <main id="main-content">
    <PlayableNav />
    <section class="page-hero section-shell">
      <p class="eyebrow" data-reveal>Aniloom Playable Quality System</p>
      <h1 data-reveal>One workflow from intent to <GradientText>release disposition.</GradientText></h1>
      <p class="page-hero__lead" data-reveal>The method connects development and Quality Engineering around meaningful states, responsive behavior, the end-user journey, saved corrections, and evidence the team can use.</p>
      <div class="page-hero__actions" data-reveal><a class="button" href="#workflow">See the workflow</a><button class="text-link" type="button" data-contact-open>Discuss your playable <span>↗</span></button></div>
    </section>

    <section class="workflow section-shell section-pad" id="workflow">
      <div class="section-heading" data-reveal><div><p class="eyebrow">The working sequence</p><h2>Each step changes what the team knows.</h2></div><p>The exact depth depends on the engagement. Development may run through the sequence repeatedly; an independent review may begin with an existing build.</p></div>
      <ol class="workflow-list">
        {steps.map((step) => <li data-reveal><span>{step.number}</span><h3>{step.title}</h3><p>{step.text}</p></li>)}
      </ol>
    </section>

    <section class="system-band section-pad">
      <div class="section-shell">
        <div class="section-heading" data-reveal><div><p class="eyebrow">Responsibilities stay explicit</p><h2>Tools support judgment. People own the decisions.</h2></div><p>AI and internal tooling may accelerate exploration, implementation, review, or correction. They do not replace accountable engineering, Quality Engineering, or the client’s release authority.</p></div>
        <div class="role-grid">
          <article data-reveal><span>Inokentii / Engineering</span><h3>Build and technical correction</h3><p>Owns implementation decisions, runtime behavior, responsive code, integrations, technical fixes, and the engineering evidence attached to those changes.</p></article>
          <article data-reveal><span>Olena / Quality Engineering</span><h3>Risk, criteria, review, and retest</h3><p>Applies the risk-based approach, defines or refines acceptance criteria, reviews the experience, coordinates issue resolution, and verifies corrected states.</p></article>
          <article data-reveal><span>Client / Release authority</span><h3>Inputs, priorities, and acceptance</h3><p>Provides the brief, target constraints, assets, access, and timely decisions, then owns acceptance of disclosed risk unless the agreement states otherwise.</p></article>
        </div>
      </div>
    </section>

    <section class="service-crosslink section-shell" data-reveal><p class="eyebrow">Choose a starting point</p><div><h2>Use the system for a build or an existing playable.</h2><div class="inline-links"><a class="text-link" href="/playable-ads/development/">Development <span>↗</span></a><a class="text-link" href="/playable-ads/qa-release-readiness/">QA & release readiness <span>↗</span></a></div></div></section>
    <section class="callout section-shell section-pad" data-reveal><p class="eyebrow">Make the current state visible</p><h2>Start with the evidence you already have.</h2><p>A brief, build, issue list, platform specification, or deadline can be enough to frame the next useful step.</p><button class="button" type="button" data-contact-open>Discuss your playable</button></section>
  </main>
</BaseLayout>
