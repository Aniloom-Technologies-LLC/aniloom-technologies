---
import BaseLayout from "../../layouts/BaseLayout.astro";
import GradientText from "../../components/GradientText.astro";
import PlayableNav from "../../components/PlayableNav.astro";

const steps = [
  { number: "01", title: "Brief and requirements", text: "Collect the brief or current build, target environments, variants, deadline, assets, known constraints, and the decision the work must support." },
  { number: "02", title: "Risk map and criteria", text: "Identify the failures that would matter most, clarify acceptance criteria, and define the screens, interactions, and configurations to review." },
  { number: "03", title: "Visual review", text: "Check layout, scale, fonts, controls, hierarchy, animation states, cropping, and content across the experience rather than only at launch." },
  { number: "04", title: "Portrait and landscape", text: "Review representative viewport sizes, orientation-specific behavior, safe areas, readability, reach, and the states where responsive problems can hide." },
  { number: "05", title: "End-user journey", text: "Follow the interaction from entry through progression, feedback, call to action, end card, outbound link, replay, and relevant failure paths." },
  { number: "06", title: "Variant and platform readiness", text: "Check agreed creative or localization variants, packaging, integration behavior, target-environment constraints, and any known limitations." },
  { number: "07", title: "Issue tracking and corrections", text: "Record issues with context and evidence. Engineering implements technical changes; suitable projects may use internal tooling to save responsive corrections." },
  { number: "08", title: "Regression and retest", text: "Recheck corrected states, related flows, orientations, and variants so the change does not quietly move the problem elsewhere." },
  { number: "09", title: "Release-readiness summary", text: "Summarize reviewed scope, passed areas, open defects, blocked checks, accepted risks, owners, and the remaining release decision." },
];
---

<BaseLayout title="How We Develop and Test Playable Ads | Aniloom Technologies" description="How Aniloom develops and tests playable ads, from brief and acceptance criteria to responsive checks, issue reports, retest, and release-readiness summary.">
  <main id="main-content">
    <PlayableNav />
    <section class="page-hero section-shell">
      <p class="eyebrow" data-reveal>Aniloom Playable Quality System</p>
      <h1 data-reveal>How we develop and test <GradientText>playable ads.</GradientText></h1>
      <p class="page-hero__lead" data-reveal>Developers and QA work from the same brief and acceptance criteria. We check the interaction and layouts during production, track issues, and retest changed builds.</p>
      <div class="page-hero__actions" data-reveal><a class="button" href="#workflow">See the workflow</a><button class="text-link" type="button" data-contact-open>Discuss your playable <span>↗</span></button></div>
    </section>

    <section class="workflow section-shell section-pad" id="workflow">
      <div class="section-heading" data-reveal><div><p class="eyebrow">The working sequence</p><h2>From brief to tested build.</h2></div><p>A development project includes implementation. An independent QA review starts with your existing build; engineering corrections require a separate scope.</p></div>
      <ol class="workflow-list">
        {steps.map((step) => <li data-reveal><span>{step.number}</span><h3>{step.title}</h3><p>{step.text}</p></li>)}
      </ol>
    </section>

    <section class="system-band surface-dark section-pad">
      <div class="section-shell">
        <div class="section-heading" data-reveal><div><p class="eyebrow">Responsibilities stay explicit</p><h2>Who is responsible for each part.</h2></div><p>Aniloom manages engineering and QA. The client provides inputs and timely feedback, and makes the final release decision unless the agreement assigns that responsibility differently.</p></div>
        <div class="role-grid">
          <article data-reveal><span>Engineering</span><h3>Build and technical correction</h3><p>Implements the interaction, responsive layouts, integrations, and technical fixes included in the scope.</p></article>
          <article data-reveal><span>Quality Engineering</span><h3>Risk, criteria, review, and retest</h3><p>Works to the review standards led by Olena, documents defects, coordinates issue resolution, and verifies corrected builds.</p></article>
          <article data-reveal><span>Client / Release authority</span><h3>Inputs, priorities, and acceptance</h3><p>Provides the brief, target constraints, assets, access, and timely decisions, then owns acceptance of disclosed risk unless the agreement states otherwise.</p></article>
        </div>
      </div>
    </section>

    <section class="service-crosslink section-shell" data-reveal><p class="eyebrow">Inspect the journeys</p><div><h2>Apply the workflow questions to three different interaction patterns.</h2><a class="text-link" href="/playable-ads/case-studies/magic-thai-playables/">Explore the Magic Thai demonstrations <span>↗</span></a></div></section>
    <section class="service-crosslink section-shell" data-reveal><p class="eyebrow">Choose a starting point</p><div><h2>Use the system for a build or an existing playable.</h2><div class="inline-links"><a class="text-link" href="/playable-ads/development/">Development <span>↗</span></a><a class="text-link" href="/playable-ads/qa-release-readiness/">QA & release readiness <span>↗</span></a></div></div></section>
    <section class="callout surface-dark section-shell section-pad"><p class="eyebrow">Make the current state visible</p><h2>Share your brief or current build.</h2><p>Send the brief or build, target specification, known issues, and deadline. We will recommend a development or QA scope.</p><button class="button" type="button" data-contact-open>Discuss your playable</button></section>
  </main>
</BaseLayout>
