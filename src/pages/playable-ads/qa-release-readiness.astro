---
import BaseLayout from "../../layouts/BaseLayout.astro";
import GradientText from "../../components/GradientText.astro";
import PlayableNav from "../../components/PlayableNav.astro";
---

<BaseLayout title="Playable Ads QA & Release Readiness | Aniloom Technologies" description="Risk-based QA and release-readiness review for playable ads across responsive states, interactions, variants, and target platform constraints.">
  <main id="main-content">
    <PlayableNav />
    <section class="page-hero page-hero--service section-shell">
      <p class="eyebrow" data-reveal>Playable Ads / QA & Release Readiness</p>
      <h1 data-reveal>Playable ad QA before <GradientText>launch.</GradientText></h1>
      <p class="page-hero__lead" data-reveal>We test your existing playable and report defects, untested areas, and remaining release risks. The review covers agreed interactions, orientations, variants, and provider requirements.</p>
      <div class="page-hero__actions" data-reveal><button class="button" type="button" data-contact-open>Discuss a review</button><a class="text-link" href="#review">See what we review <span>↓</span></a></div>
    </section>

    <section class="entry-points section-shell section-pad" id="review">
      <div class="section-heading" data-reveal><div><p class="eyebrow">Risk-based review</p><h2>Test the interaction from first input to click-through.</h2></div><p>We prioritize failures that could prevent a user from understanding the playable, completing the interaction, or reaching the intended destination.</p></div>
      <div class="review-grid">
        <article data-reveal><span>Journey</span><h3>From entry to campaign action</h3><p>Core interaction, progression, feedback, calls to action, end cards, links, replay behavior, and failure or exit paths.</p></article>
        <article data-reveal><span>Presentation</span><h3>Instructions, gameplay, and results</h3><p>Layout, scale, fonts, visual hierarchy, readability, controls, animation states, and content that appears during the flow.</p></article>
        <article data-reveal><span>Responsive</span><h3>Portrait and landscape</h3><p>Representative viewport sizes, orientation changes, safe areas, cropping, alignment, and interaction reach across agreed states.</p></article>
        <article data-reveal><span>Readiness</span><h3>Variants and platforms</h3><p>Agreed builds, localization or creative variants, integration behavior, target-environment constraints, and known limitations.</p></article>
      </div>
    </section>

    <section class="system-band section-pad">
      <div class="section-shell">
        <div class="section-heading" data-reveal><div><p class="eyebrow">The output</p><h2>What you receive after testing.</h2></div><p>Receive prioritized findings, the scope tested, and a release-readiness summary. One retest is included after corrections; engineering fixes are scoped separately.</p></div>
        <div class="deliverable-grid">
          <div data-reveal><span>Test scope and gaps</span><p>Interactions, orientations, variants, and configurations reviewed, with untested areas and assumptions identified.</p></div>
          <div data-reveal><span>Prioritized defect report</span><p>Reproduction context, observed behavior, expected behavior, supporting evidence, severity, and ownership.</p></div>
          <div data-reveal><span>Retest results</span><p>We recheck the corrected build once and record which findings are resolved or still open. Engineering fixes require a separate scope.</p></div>
          <div data-reveal><span>Release-readiness summary</span><p>A summary of tested areas, open defects, blocked checks, and risks for the team making the release decision.</p></div>
        </div>
        <p class="system-note" data-reveal>This work is not certification and does not guarantee defect-free delivery, campaign performance, or acceptance by an advertising platform.</p>
      </div>
    </section>

    <section class="quality-lead section-pad">
      <div class="section-shell quality-lead__grid">
        <div data-reveal><p class="eyebrow">Quality responsibility</p><h2>QA leadership and coordination.</h2><p>Olena leads the Quality Engineering practice and its review standards. QA findings give developers the context needed to reproduce issues and prepare corrections for retest.</p></div>
        <div class="quality-orbit" data-reveal aria-label="Playable quality concerns"><span>Journey</span><span>Responsive</span><span>Evidence</span><span>Variants</span><strong>Decision</strong></div>
      </div>
    </section>

    <section class="service-crosslink section-shell" data-reveal><p class="eyebrow">Review in context</p><div><h2>See how different playable journeys create different quality questions.</h2><a class="text-link" href="/playable-ads/case-studies/magic-thai-playables/">Inspect the Magic Thai demonstrations <span>↗</span></a></div></section>
    <section class="service-crosslink section-shell" data-reveal><p class="eyebrow">Defined engagement</p><div><h2>See the review package, price, and inputs.</h2><a class="text-link" href="/playable-ads/release-quality-platform-readiness/">See the package structure <span>↗</span></a></div></section>
    <section class="callout section-shell section-pad" data-reveal><p class="eyebrow">Bring the current build</p><h2>Send us the playable you need tested.</h2><p>Share the playable, target provider specification, variants, known issues, and deadline. We will confirm the testing scope and inputs required.</p><button class="button" type="button" data-contact-open>Discuss a review</button></section>
  </main>
</BaseLayout>
