---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PlayableNav from "../../components/PlayableNav.astro";
import PricingCard from "../../components/PricingCard.astro";

const primaryPackages = [
  {
    id: "development-package",
    title: "Playable Ads Development",
    price: "$5,000 USD",
    summary: "A finished HTML5/WebGL playable, checked and packaged for one chosen ad network.",
    inclusions: [
      "One playable from an approved concept, reference, or product flow",
      "One core interaction in HTML5 or WebGL",
      "Portrait and landscape, including iPhone/iPad resolutions and 9:22 / 22:9 layouts",
      "Tutorial, gameplay, result, and CTA states",
      "One language and one behavioral variant",
      "One ad-network provider package with basic click-through or agreed analytics hooks",
      "Two review rounds, interaction checks, and final provider-package validation",
      "Production package, source handoff, and a Cloudflare Workers live demo link",
    ],
    note: "You supply approved assets. Custom art, substantial animation, extra variants, localization, and extra provider packages are add-ons. Plan for 10-15 business days after complete inputs and access; the proposal confirms the timeline.",
  },
];

const addOns = [
  {
    title: "Creative Production",
    price: "$1,500 USD",
    summary: "Project-specific UI, 2D or 3D asset work, or substantial animation under an agreed asset list.",
    inclusions: ["The proposal identifies the approved asset list and production boundary."],
  },
  {
    title: "Variants, Localization & Provider Adaptation",
    price: "$750 USD",
    summary: "One additional behavioral variant, an agreed batch of client-supplied translations, or one additional provider package, depending on complexity.",
    inclusions: ["The proposal states which adaptation is included."],
  },
];
---

<BaseLayout title="Playable Ad Pricing & Production Scope | Aniloom Technologies" description="A finished playable ad from $5,000 USD. See the development package, included checks and delivery, timelines, creative production, and network adaptations.">
  <main id="main-content" class="pricing-page">
    <PlayableNav />
    <section class="pricing-stage pricing-stage--catalog surface-light" id="packages">
      <div class="section-shell">
        <header class="pricing-intro">
          <h1>Playable Ad Pricing</h1>
          <p>One finished playable, with the production scope, checks, and delivery defined before work starts.</p>
        </header>
        <div class="pricing-group">
          <h2 class="visually-hidden">Playable development package</h2>
          <div class="pricing-grid pricing-grid--one">
            {primaryPackages.map((item) => <PricingCard {...item} />)}
          </div>
        </div>

        <div class="pricing-group pricing-group--addons">
          <div class="section-heading" data-reveal><div><p class="eyebrow">Optional add-ons</p><h2>Add creative production or more versions.</h2></div><p>Extend the base playable with custom assets, another behavioral variant, supplied translations, or an additional provider package.</p></div>
          <div class="pricing-grid pricing-grid--two">
            {addOns.map((item) => <PricingCard {...item} />)}
          </div>
        </div>
      </div>
    </section>

    <section class="section-shell section-pad playable-readiness" id="delivery-details" aria-labelledby="delivery-title">
      <div class="section-heading" data-reveal><div><p class="eyebrow">Plan the production</p><h2 id="delivery-title">Agree on inputs, reviews, and the final files.</h2></div><p>The base package uses your approved concept and assets. Plan for 10-15 business days after complete inputs and access; the proposal confirms the schedule.</p></div>
      <div class="playable-readiness__grid">
        <article data-reveal><h3>What you provide</h3><p>An approved concept or reference, product and brand assets, required copy, one target provider specification, the destination link, analytics requirements, and a decision-maker for the two review rounds.</p></article>
        <article data-reveal><h3>What you receive</h3><p>One finished playable with tutorial, gameplay, result, and CTA states. Delivery includes the selected network’s production package, source files, and a live demo link, with the agreed interaction, layout, and package checks completed.</p></article>
      </div>
      <details class="playable-readiness__boundaries"><summary>Scope changes and additional production</summary><p>Custom art, substantial animation, extra behavioral variants, localization, extra providers, unusual analytics, and post-handoff iteration are separate scope. Technical corrections within the agreed playable production scope are part of development.</p><p>The proposal defines delivery requirements and acceptance criteria. Network campaign approval and advertising performance remain outside the production commitment.</p></details>
      <a class="text-link" href="/playable-ads/#workflow">Explore the full production process <span>↗</span></a>
    </section>

    <section class="pricing-terms section-shell section-pad">
      <div class="section-heading" data-reveal><div><p class="eyebrow">Commercial terms</p><h2>What “starting at” means.</h2></div><p>The final proposal is the source of truth for the exact scope and commercial agreement.</p></div>
      <div class="pricing-terms__grid">
        <p data-reveal><span>Currency</span>Prices are in USD and exclude applicable taxes.</p>
        <p data-reveal><span>Project payments</span>Project packages are normally 50% to schedule and 50% before final handoff.</p>
        <p data-reveal><span>Final scope</span>The proposal controls the timeline, amount, assumptions, add-ons, and change control.</p>
      </div>
    </section>

    <section class="callout surface-dark section-shell section-pad"><p class="eyebrow">Bring your playable idea</p><h2>Define your playable’s scope.</h2><p>Share your concept or reference, target networks, available assets, and deadline. We will confirm the production scope and quote.</p><a class="button" href="/contact/">Discuss a playable</a></section>
  </main>
</BaseLayout>
