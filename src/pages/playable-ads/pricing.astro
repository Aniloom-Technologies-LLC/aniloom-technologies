---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PlayableNav from "../../components/PlayableNav.astro";
import PricingCard from "../../components/PricingCard.astro";

const packages = [
  {
    id: "adapted-playable",
    label: "A focused creative, ready to build",
    title: "Adapted Playable",
    price: "$799 USD",
    summary: "Turn a ready mechanic into a finished playable for your game or product. A practical starting point for a series of creatives.",
    inclusions: [
      "One ready mechanic adapted to your product and brand",
      "Your supplied assets, with UI and copy adapted to the playable",
      "Existing animation, effects, and supplied audio fitted to the experience",
      "Tutorial, gameplay, result, and destination CTA",
      "One language and one gameplay version",
      "One consolidated revision round",
      "Portrait, landscape, interaction, and final-package checks",
      "Source files and a Cloudflare Workers live demo link",
    ],
    bestFor: "Teams producing a steady series of playable creatives from ready mechanics.",
    bonus: "Builds for all supported ad networks included.",
    note: "Plan for 3-5 business days after the mechanic, assets, and brief are approved. New mechanics and original asset production are quoted separately.",
  },
  {
    id: "custom-playable",
    label: "A complete custom production",
    title: "Custom Playable",
    price: "$4,499 USD",
    summary: "Everything in Adapted Playable, expanded around your approved mechanic and creative direction. Custom art, game-specific animation, and three visual skins for A/B testing.",
    inclusions: [
      "An approved ready or custom mechanic tailored to your product",
      "Custom UI, branded copy, and tutorial guidance",
      "Original 2D or 3D asset production under an agreed asset list",
      "Game-specific animation, effects, and interaction feedback",
      "Spine 2D rigs and character animation where included in the brief",
      "Custom animation sequences, transitions, and result presentation",
      "Music and sound integration from agreed asset sources",
      "A destination CTA connected to your agreed store or landing page",
      "Three visual skins in total of the same approved mechanic",
      "One language, with two consolidated revision rounds",
      "Portrait, landscape, long-screen, and interaction checks for every skin",
      "Provider-specific file-limit, entry-file, and package validation",
      "Project source files and live demo links for all three skins",
    ],
    bestFor: "Teams with a clear product hook and a defined creative vision to bring to life.",
    bonus: "Builds for all supported ad networks included for every skin.",
    note: "Plan for 10-15 business days after the brief and production inputs are approved. The asset list, animation scope, and final schedule are confirmed in your proposal.",
  },
  {
    id: "micro-playable",
    label: "One tap on your artwork",
    title: "Micro Playable",
    price: "$299 USD",
    summary: "Add one interactive moment to a static ad. A tap changes one element, then reveals the button to your store or landing page.",
    inclusions: [
      "One supplied static scene, adapted to your brand",
      "One tap target and one simple visual response",
      "A CTA shown after the interaction",
      "One language and one creative version",
      "One consolidated round of copy and visual adjustments",
      "Portrait, landscape, interaction, and final-package checks",
      "Source files and a Cloudflare Workers live demo link",
    ],
    bestFor: "Teams testing artwork and a simple interaction hook before investing in gameplay.",
    bonus: "Builds for all supported ad networks included.",
    note: "Plan for 1-2 business days after complete artwork and copy are approved. Scope covers one action on existing art; gameplay loops and original asset production are separate work.",
  },
];

const questions = [
  {
    question: "What will we receive?",
    answer: "A finished HTML5/WebGL creative with on-screen instructions, an interaction, a result, and a CTA to your agreed store or landing page. Micro has one tap on static artwork; Adapted and Custom include a gameplay experience. Handoff includes the network-specific HTML or ZIP files, project source files, and a live demo hosted on Cloudflare Workers. Custom Playable includes three visual skins and their delivery files.",
  },
  {
    question: "How do we choose a package?",
    answer: "Choose Micro Playable for one tap on existing artwork, such as removing an icon and revealing a CTA. Choose Adapted Playable when a ready mechanic can communicate your product using existing assets and animation. It suits individual creatives and repeat production. Choose Custom Playable when you have a clear product hook and need a tailored mechanic, original visual production, or game-specific animation. It includes the Adapted essentials with a larger agreed production scope. We agree on the mechanic before full production so the three skins share the same gameplay.",
  },
  {
    question: "How does a Micro Playable work?",
    answer: "The viewer takes one action on a supplied static scene before the CTA appears. For example, they tap an icon, it disappears, and a button opens your product link. The scope covers that single interaction and its visual response. A gameplay loop, score progression, or further player actions belong in Adapted or Custom scope. Your team can use Micro in campaign tests of artwork or a simple interaction hook.",
  },
  {
    question: "What counts as a skin for A/B testing?",
    answer: "A skin changes the agreed visual presentation, such as artwork, colors, or theme, while keeping the approved mechanic and gameplay structure. Custom Playable includes three skins in total. New mechanics, different gameplay branches, extra languages, or further skins are separately scoped. You can use the supplied versions in your own campaign tests; campaign setup and performance analysis are separate work.",
  },
  {
    question: "Which ad-network builds are included as a bonus?",
    answer: "All three packages include builds for all our currently supported networks: AppLovin, Google Ads, Unity Ads, Meta, TikTok, Pangle, Mintegral, Liftoff, Moloco, and ironSource Exchange. Custom Playable includes these builds for all three skins. Each network receives its required format, rather than one universal upload file. We confirm current specifications and any account-specific requirements before production.",
  },
  {
    question: "How do you check the finished playable?",
    answer: "We check the complete interaction, state changes, and the CTA destination. Layout checks cover portrait and landscape, iPhone and iPad resolutions, and long 9:22 and 22:9 screens. We use the Google Ads, AppLovin, Liftoff, and Mintegral preview or validation tools for their delivery formats. We check entry files, HTML or ZIP packaging, and file limits, then correct issues within our agreed production scope before handoff. Network campaign approval remains with the platform.",
  },
  {
    question: "Where do the artwork and visual assets come from?",
    answer: "We can use your game assets, our reusable assets, free assets with suitable commercial licenses, or paid asset libraries. We can also use AI-assisted artwork under experienced human direction, or commission original work from artists when requested. We agree on the source, visual direction, asset list, and usage requirements before production. Original illustration, detailed 3D work, and multiple approval stages can extend the schedule and quote.",
  },
  {
    question: "Where do music and sound effects come from?",
    answer: "Options include your supplied audio, our own assets, free commercially licensed music and sounds, paid libraries, and AI-generated sounds reviewed by our team. Custom music and sound design from musicians or sound designers can be commissioned on request. We choose the approach with you and account for license terms and any required attribution. Custom composition and recording need additional production and review time.",
  },
  {
    question: "Can you create custom animations?",
    answer: "Yes. Micro uses one simple change to static art. Adapted Playable uses existing animations and effects. Custom Playable includes an agreed set of game-specific animations, which can use Spine 2D and custom animation sequences. We define the characters, rigs, states, transitions, and sequence count in the proposal. Larger animation sets or additional asset creation change the scope and schedule.",
  },
  {
    question: "What do we need to provide, and how long does it take?",
    answer: "Share your product or game, reference or concept, available assets, brand guidance, required copy, destination link, analytics needs, and deadline. Nominate one person to consolidate feedback. Plan for 1-2 business days for Micro Playable, 3-5 for Adapted Playable, or 10-15 for Custom Playable after complete inputs and approvals. Asset sourcing, original art or music, animation complexity, and feedback timing affect delivery. Your proposal confirms the schedule.",
  },
  {
    question: "What is included in a revision round?",
    answer: "A round is one consolidated set of feedback on the agreed mechanic and production direction: for example, copy, visual tuning, animation timing, or CTA presentation. Micro includes one round of copy and visual adjustments. Adapted Playable includes one round; Custom Playable includes two. Technical corrections within the agreed production scope are included. A new mechanic, changed concept, extra skins, or ongoing post-handoff iteration receives a separate estimate.",
  },
  {
    question: "What rights and source files do we receive?",
    answer: "The handoff includes the agreed project source files and delivery builds. Your proposal identifies usage rights for commissioned work and the licenses for third-party, reusable, or AI-assisted assets. Those sources have different terms; exclusive rights to library assets or shared tools are not implied. Please supply assets you have permission to use. Paid licenses and specialist commissions are identified in the quote before work starts.",
  },
];
---

<BaseLayout title="Playable Ad Pricing & Packages | Aniloom Technologies" description="Micro playable ads from $299, adapted gameplay from $799, and custom production from $4,499. Compare scope, visual skins, included network builds, and delivery.">
  <main id="main-content" class="pricing-page">
    <PlayableNav />
    <section class="pricing-stage pricing-stage--catalog surface-light" id="packages">
      <div class="section-shell">
        <header class="pricing-intro">
          <h1>Playable Ad Pricing</h1>
          <p>Choose a single tap, a ready gameplay mechanic, or a custom experience. Every package includes source files, a live demo, and ad-network builds.</p>
        </header>
        <div class="pricing-group">
          <h2 class="visually-hidden">Choose your playable production package</h2>
          <div class="pricing-grid pricing-grid--playable">
            {packages.map((item) => <PricingCard {...item} />)}
          </div>
        </div>
      </div>
    </section>

    <section class="section-shell section-pad playable-readiness" id="delivery-details" aria-labelledby="delivery-title">
      <div class="section-heading" data-reveal><div><p class="eyebrow">Plan the production</p><h2 id="delivery-title">Agree on the creative before we build.</h2></div><p>We confirm the mechanic, asset sources, review checkpoints, and delivery requirements in one proposal.</p></div>
      <div class="playable-readiness__grid">
        <article data-reveal><h3>Start with your product</h3><p>Send a game build, product link, or reference alongside your available artwork, copy, and CTA destination. We identify what can be reused and what needs to be created.</p></article>
        <article data-reveal><h3>Review a working playable</h3><p>Use the browser demo at agreed checkpoints and share consolidated feedback. Final handoff follows the included interaction, layout, and provider-package checks.</p></article>
      </div>
      <a class="text-link" href="/playable-ads/#workflow">Explore the full production process <span>↗</span></a>
    </section>

    <section class="section-shell section-pad playable-faq" id="questions" aria-labelledby="questions-title">
      <div class="section-heading" data-reveal><div><p class="eyebrow">Questions & answers</p><h2 id="questions-title">Know what goes into your playable.</h2></div><p>The result, asset choices, reviews, and timing, explained before you commit.</p></div>
      {questions.map(({ question, answer }) => <details><summary>{question}</summary><p>{answer}</p></details>)}
    </section>

    <section class="pricing-terms section-shell section-pad">
      <div class="section-heading" data-reveal><div><p class="eyebrow">Commercial terms</p><h2>What “starting at” means.</h2></div><p>Each price is a starting point for the scope shown. We confirm a project quote after reviewing your brief.</p></div>
      <div class="pricing-terms__grid">
        <p data-reveal><span>Currency & costs</span>Prices are in USD before applicable taxes. Any paid asset licenses or additional production costs are identified in your quote.</p>
        <p data-reveal><span>Project payments</span>Project packages are normally 50% to schedule and 50% before final handoff.</p>
        <p data-reveal><span>Final scope</span>Your proposal confirms the asset list, versions, timeline, price, and how scope changes are handled.</p>
      </div>
      <p class="playable-campaign-note">Need help beyond the creative? We can manage your advertising campaign or broader marketing campaign, with scope and fees agreed individually.</p>
    </section>

    <section class="callout surface-dark section-shell section-pad"><p class="eyebrow">Bring your playable idea</p><h2>Choose a starting point.</h2><p>Share your product, available assets, and deadline. We will recommend a production path and confirm the scope and quote.</p><a class="button" href="/contact/">Discuss a playable</a></section>
  </main>
</BaseLayout>
