---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PlayableNav from "../../components/PlayableNav.astro";
import PricingCard from "../../components/PricingCard.astro";

const primaryPackages = [
  {
    title: "Playable Ads Development",
    price: "$5,000 USD",
    summary: "Build one playable from your approved concept, reference, or product flow.",
    inclusions: [
      "One playable from an approved concept, reference, or product flow",
      "One core interaction in HTML5 or WebGL",
      "Portrait and landscape layouts",
      "Tutorial, gameplay, result, and CTA states",
      "One language and one behavioral variant",
      "One ad-network provider package with basic click-through or agreed analytics hooks",
      "Two review rounds and a release-quality review",
      "Production package and source handoff",
    ],
    note: "You supply approved assets. Custom art, substantial animation, extra variants, localization, and extra provider packages are add-ons. Plan for 10-15 business days after complete inputs and access; the proposal confirms the timeline.",
  },
  {
    title: "Playable Release Quality and Platform Readiness",
    price: "$1,500 USD",
    summary: "Test one existing playable before delivery or launch, with findings and one retest.",
    inclusions: [
      "One stable playable in portrait and landscape",
      "Up to two behavioral variants",
      "One ad-network provider package",
      "Intake and risk map",
      "Visual, responsive, end-user, variant, and package review",
      "Findings with supporting evidence",
      "One retest after corrections",
      "Release summary",
    ],
    note: "Plan for 3-5 business days after stable-build access. Engineering fixes are separate scope. The proposal confirms the timeline.",
  },
];

const addOns = [
  {
    title: "Creative Production",
    price: "$1,500 USD",
    summary: "Project-specific UI, 2D or 3D asset work, or substantial animation under an agreed asset list.",
    inclusions: ["The proposal identifies the approved asset list and production boundary."],
  },
  {
    title: "Variants, Localization & Provider Adaptation",
    price: "$750 USD",
    summary: "One additional behavioral variant, an agreed batch of client-supplied translations, or one additional provider package, depending on complexity.",
    inclusions: ["The proposal states which adaptation is included."],
  },
  {
    title: "Correction & Retest Sprint",
    price: "$1,500 USD",
    summary: "Engineering fixes for an agreed list of findings, followed by targeted retesting.",
    inclusions: ["This is a defined sprint, not unlimited remediation."],
  },
];
---

<BaseLayout title="Playable Ads Development & QA Pricing | Aniloom Technologies" description="Starting prices and base scopes for Playable Ads development, playable QA and release readiness, and optional production or adaptation add-ons.">
  <main id="main-content" class="pricing-page">
    <PlayableNav />
    <section class="pricing-stage pricing-stage--catalog surface-light" id="packages">
      <div class="section-shell">
        <header class="pricing-intro">
          <h1>Playable Ads Development & QA Pricing</h1>
          <p>Choose development for a new playable or QA for an existing build. Engineering fixes are separate scope.</p>
        </header>
        <div class="pricing-group">
          <h2 class="visually-hidden">Primary packages</h2>
          <div class="pricing-grid pricing-grid--two pricing-grid--primary">
            {primaryPackages.map((item) => <PricingCard {...item} />)}
          </div>
        </div>

        <div class="pricing-group pricing-group--addons">
          <div class="section-heading" data-reveal><div><p class="eyebrow">Optional add-ons</p><h2>Add art, adaptations, or engineering fixes.</h2></div><p>Add custom production, another variant or provider package, localization, or a correction sprint when your project needs it.</p></div>
          <div class="pricing-grid pricing-grid--three">
            {addOns.map((item) => <PricingCard {...item} />)}
          </div>
        </div>
      </div>
    </section>

    <section class="pricing-terms section-shell section-pad">
      <div class="section-heading" data-reveal><div><p class="eyebrow">Commercial terms</p><h2>What “starting at” means.</h2></div><p>The final proposal is the source of truth for the exact scope and commercial agreement.</p></div>
      <div class="pricing-terms__grid">
        <p data-reveal><span>Currency</span>Prices are in USD and exclude applicable taxes.</p>
        <p data-reveal><span>Project payments</span>Project packages are normally 50% to schedule and 50% before final handoff.</p>
        <p data-reveal><span>Final scope</span>The proposal controls the timeline, amount, assumptions, add-ons, and change control.</p>
      </div>
    </section>

    <section class="callout section-shell section-pad" data-reveal><p class="eyebrow">Bring the brief or the build</p><h2>Find the right playable package.</h2><p>Share the brief or build, target provider, available assets, variants, and deadline. We will recommend a package and confirm the scope.</p><button class="button" type="button" data-contact-open>Discuss a playable</button></section>
  </main>
</BaseLayout>
