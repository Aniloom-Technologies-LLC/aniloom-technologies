---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import GradientText from "../../components/GradientText.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={`${post.data.title} | Aniloom Technologies`} description={post.data.description} ogType="article" image={post.data.hero ? `${post.data.hero}.webp` : undefined} imageAlt={post.data.heroAlt} imageWidth={post.data.heroWidth} imageHeight={post.data.heroHeight} article={{ headline: post.data.title, datePublished: post.data.publishDate.toISOString(), dateModified: post.data.updatedDate?.toISOString() }}>
  <main id="main-content">
    <article class="article-shell section-shell">
      <header class="article-header">
        <div><span class="eyebrow">{post.data.category}</span><span>{post.data.publishDate.toLocaleDateString("en-US", { dateStyle: "long", timeZone: "UTC" })}</span></div>
        <h1><GradientText>{post.data.title}</GradientText></h1>
        <p>{post.data.description}</p>
        <p class="article-header__byline">Written by Aniloom Technologies{post.data.updatedDate && ` · Updated ${post.data.updatedDate.toLocaleDateString("en-US", { dateStyle: "long", timeZone: "UTC" })}`}</p>
        {post.data.hero && (
          <figure class="article-hero">
            <picture>
              <source srcset={`${post.data.hero}.avif`} type="image/avif" />
              <img src={`${post.data.hero}.webp`} alt={post.data.heroAlt ?? ""} width={post.data.heroWidth} height={post.data.heroHeight} decoding="async" />
            </picture>
          </figure>
        )}
      </header>
      <div class="article-content"><Content /></div>
      <p class="article-content"><a href={post.data.category === "Quality Engineering" ? "/quality-engineering/" : "/capabilities/"}>{post.data.category === "Quality Engineering" ? "Explore software testing services" : "Explore development and design capabilities"}</a></p>
      <footer class="article-footer"><a class="text-link" href="/insights/">← Back to all notes</a><button class="text-link" type="button" data-contact-open>Discuss your project ↗</button></footer>
    </article>
  </main>
</BaseLayout>
