---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import GradientText from "../../components/GradientText.astro";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime());
---

<BaseLayout title="Software Development and Testing Notes | Aniloom Technologies" description="Notes on product engineering, quality, playable experiences, technical art, and the decisions behind delivery.">
  <main id="main-content">
    <section class="page-hero section-shell">
      <p class="eyebrow" data-reveal>Notes from the work</p>
      <h1 data-reveal>Notes on software development <GradientText>and testing.</GradientText></h1>
      <p class="page-hero__lead" data-reveal>Practical writing on product engineering, quality, playable experiences, technical art, and the decisions that affect real delivery.</p>
    </section>
    <section class="notes-index section-shell section-pad">
      {posts.map((post, index) => (
        <a class="note-row" href={`/insights/${post.id}/`} data-reveal>
          <span class="note-row__number">{String(index + 1).padStart(2, "0")}</span>
          <div class="note-row__content">
            {post.data.hero && <picture class="note-row__art" aria-hidden="true"><source srcset={`${post.data.hero}.avif`} type="image/avif" /><img src={`${post.data.hero}.webp`} alt="" width={post.data.heroWidth} height={post.data.heroHeight} loading="lazy" decoding="async" /></picture>}
            <span class="eyebrow">{post.data.category}</span><h2>{post.data.title}</h2><p>{post.data.description}</p>
          </div>
          <div class="note-row__meta"><span>{post.data.publishDate.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric", timeZone: "UTC" })}</span><span>↗</span></div>
        </a>
      ))}
    </section>
  </main>
</BaseLayout>
