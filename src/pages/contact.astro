---
import BaseLayout from "../layouts/BaseLayout.astro";
import Scene from "../components/Scene.astro";
const endpoint = import.meta.env.PUBLIC_CONTACT_ENDPOINT || "https://aniloom-contact.aniloom.workers.dev";
---

<BaseLayout title="Contact | Aniloom Technologies" description="Discuss a playable ad, release testing, or a software project with Aniloom. Send your project description or email support@aniloom.tech." appearance="dark" showSplashCursor={false}>
  <main id="main-content">
    <Scene appearance="dark">
      <section class="contact-page section-shell" aria-labelledby="contact-title">
        <div class="contact-page__intro">
          <p class="eyebrow">A practical first conversation</p>
          <h1 id="contact-title">Contact us.</h1>
          <p>Tell us what your product needs next. Share your goal, the current brief or build, and your target timeline.</p>
        </div>
        <form class="contact-form" id="contact-form" data-contact-form data-endpoint={endpoint} aria-describedby="contact-privacy">
          <p class="contact-topic" data-contact-topic-label hidden></p>
          <input type="hidden" name="topic" value="" />
          <label class="contact-field" for="contact-email">Email <span class="contact-field__hint">Required. We will reply to this address.</span></label>
          <input id="contact-email" name="email" type="email" autocomplete="email" inputmode="email" maxlength="254" required />
          <label class="contact-field" for="contact-project">Project description <span class="contact-field__hint">Required. A short outline is enough to start.</span></label>
          <textarea id="contact-project" name="project" rows="5" maxlength="5000" required placeholder="What are you building or testing, and what do you need help with?"></textarea>
          <div class="contact-honeypot" aria-hidden="true"><label for="contact-website">Leave this field empty</label><input id="contact-website" name="website" type="text" tabindex="-1" autocomplete="off" /></div>
          <div data-contact-verification></div>
          <p class="contact-form__note" id="contact-privacy">We use your details to respond to your inquiry. <a href="/privacy-policy/">Privacy policy</a></p>
          <button class="button" type="submit" data-contact-submit disabled>Send message</button>
          <p class="contact-status" data-contact-status role="status" aria-live="polite" aria-atomic="true" hidden>Checking message availability…</p>
          <noscript><p>To use this form, enable JavaScript for spam protection. You can also email <a href="mailto:support@aniloom.tech">support@aniloom.tech</a>.</p></noscript>
        </form>
      </section>
    </Scene>
    <Scene appearance="light">
      <section class="contact-direct section-shell" aria-labelledby="contact-direct-title">
        <p class="eyebrow">Prefer email?</p>
        <h2 id="contact-direct-title">Write to us directly.</h2>
        <div class="contact-direct__actions"><a class="contact-email" href="mailto:support@aniloom.tech">support@aniloom.tech</a><button type="button" class="button button--secondary" data-copy-email hidden>Copy email</button></div>
        <p data-copy-status role="status" aria-live="polite" aria-atomic="true"></p>
      </section>
    </Scene>
  </main>
  <script src="/assets/js/contact-form.js" defer></script>
</BaseLayout>
