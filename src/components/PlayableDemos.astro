---
const localModules: Record<string, string | undefined> = import.meta.env.DEV ? {
  "magic-thai-a": import.meta.env.PUBLIC_MAGIC_THAI_A_MODULE_URL,
  "magic-thai-b": import.meta.env.PUBLIC_MAGIC_THAI_B_MODULE_URL,
  "magic-thai-c": import.meta.env.PUBLIC_MAGIC_THAI_C_MODULE_URL,
} : {};
const demos = [
  { id: "magic-thai-a", name: "Tap to Build with a Character", mechanic: "Village builder", description: "Tap the hammers or BUILD to raise a village while an animated builder reacts to each construction.", url: "https://magic-thai-ad-a1.aniloom.workers.dev/", image: "tap-to-build-with-a-character.webp", alt: "Tap to Build with a Character: an animated builder invites the player to build a village." },
  { id: "magic-thai-b", name: "Spin and Run for Coins", mechanic: "Slots + runner", description: "Spin to unlock a bonus run, then steer the runner to collect coins.", url: "https://magic-thai-ad-b1.aniloom.workers.dev/", image: "spin-and-run-for-coins.webp", alt: "Spin and Run for Coins: five reels above a runner on a tropical path." },
  { id: "magic-thai-c", name: "Match Three to Clear Trays", mechanic: "Matching puzzle", description: "Pick matching items to complete sets of three and clear every tray.", url: "https://magic-thai-ad-c1.aniloom.workers.dev/", image: "match-three-to-clear-trays.webp", alt: "Match Three to Clear Trays: apple, avocado, and berry trays with items to pick and match." },
];
---

<section class="playable-demos section-shell section-pad" id="demonstrations" aria-labelledby="demos-title" data-playable-demos>
  <div class="section-heading" data-reveal>
    <div><p class="eyebrow">Play our work</p><h2 id="demos-title">Try three playable ads.</h2></div>
    <p>Choose a game and play here. Expand a game for a larger view. Sound follows the game you are playing.</p>
  </div>
  <div class="playable-demo-grid">
    {demos.map((demo) => (
      <article class="playable-demo" id={demo.id} data-game-module={localModules[demo.id] ?? `${demo.url}game.js`} data-game-name={demo.name} data-playable-demo aria-labelledby={`${demo.id}-title`}>
        <div class="playable-demo__preview">
          <div class="playable-demo__player" data-demo-stage aria-label={`${demo.name} player`}>
            <div class="playable-demo__viewport" data-demo-viewport>
              <div class="playable-demo__mount" data-demo-mount></div>
              <img src={`/assets/images/proof/${demo.image}`} alt={demo.alt} width="1080" height="1920" loading="lazy" decoding="async" />
              <div class="playable-demo__overlay" data-demo-overlay>
                <p class="playable-demo__status" data-demo-status role="status" aria-live="polite"></p>
                <button class="button button--small" type="button" data-demo-start disabled aria-label={`Play ${demo.name}`}>Play</button>
              </div>
              <div class="playable-demo__controls" aria-label="Game controls">
                <button class="playable-demo__control" type="button" data-demo-restart hidden aria-label={`Restart ${demo.name}`} title="Restart">
                  <svg viewBox="0 0 48 48" aria-hidden="true"><path d="M35 15a14 14 0 0 0-23 6M12 21v-9m0 9h9M13 33a14 14 0 0 0 23-6m0 0v9m0-9h-9" /></svg>
                </button>
                <button class="playable-demo__control" type="button" data-demo-fullscreen aria-expanded="false" aria-label={`Expand ${demo.name}`} title="Expand">
                  <svg class="playable-demo__expand-icon" viewBox="0 0 48 48" aria-hidden="true"><path d="M18 10h-8v8m20-8h8v8M10 30v8h8m20-8v8h-8" /></svg>
                  <svg class="playable-demo__close-icon" viewBox="0 0 48 48" aria-hidden="true"><path d="m13 13 22 22m0-22L13 35" /></svg>
                </button>
              </div>
            </div>

          </div>
        </div>
        <div class="playable-demo__body">
          <div class="playable-demo__action"><h3 id={`${demo.id}-title`}>{demo.name}</h3></div>
          <p class="eyebrow">{demo.mechanic}</p>
          <p>{demo.description}</p>
        </div>
      </article>
    ))}
  </div>
  <p class="playable-demos__note">Public demonstrations, not client campaign results or evidence of advertising-platform acceptance.</p>
  <noscript><p>Enable JavaScript to play the demos.</p></noscript>
</section>

<script>
  import { initializePlayableDemos } from "../lib/playable-demos";
  document.querySelectorAll<HTMLElement>("[data-playable-demos]").forEach(initializePlayableDemos);
</script>
