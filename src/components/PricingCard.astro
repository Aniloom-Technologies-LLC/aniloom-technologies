---
interface Props {
  id?: string;
  title: string;
  price: string;
  summary: string;
  inclusions: string[];
  label?: string;
  note?: string;
  bonus?: string;
  bestFor?: string;
  cadence?: string;
  detailsHref?: string;
}

const { id, title, price, summary, inclusions, label, note, bonus, bestFor, cadence, detailsHref } = Astro.props;
---

<article class="pricing-card" id={id}>
  {label && <p class="pricing-card__label">{label}</p>}
  <h3>{title}</h3>
  <p class="pricing-card__price"><span>Starting at</span><strong>{price}</strong>{cadence && <small>{cadence}</small>}</p>
  <p class="pricing-card__summary">{summary}</p>
  <ul class="pricing-card__scope">
    {inclusions.map((item) => <li>{item}</li>)}
  </ul>
  {bonus && <p class="pricing-card__bonus"><span>Included bonus</span>{bonus}</p>}
  {note && <p class="pricing-card__note">{note}</p>}
  {detailsHref && <a class="pricing-card__details" href={detailsHref}>See QA inputs & reports <span aria-hidden="true">↓</span></a>}
  {bestFor && <p class="pricing-card__fit"><span>Best for</span>{bestFor}</p>}
  <a class="text-link" href={`/contact/?topic=${encodeURIComponent(title)}`}>Discuss this package <span>↗</span></a>
</article>
