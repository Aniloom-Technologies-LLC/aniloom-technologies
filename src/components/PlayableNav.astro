---
const pathname = Astro.url.pathname;
const items = [
  { href: "/playable-ads/", label: "Overview", exact: true },
  { href: "/playable-ads/#demonstrations", label: "Try the demos", anchor: true },
  { href: "/playable-ads/pricing/", label: "Pricing" },
];

const isCurrent = (item: (typeof items)[number]) => !item.anchor && (item.exact ? pathname === item.href : pathname.startsWith(item.href));
---

<nav class="playable-nav section-shell" aria-label="Playable Ads">
  <p>Playable Ads</p>
  <div>
    {items.map((item) => <a href={item.href} aria-current={isCurrent(item) ? "page" : undefined}>{item.label}</a>)}
  </div>
</nav>
