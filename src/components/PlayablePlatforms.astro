---
interface Props { compact?: boolean }
const { compact = false } = Astro.props;
const platforms = [
  { name: "AppLovin", icon: "applovin.png" },
  { name: "Google Ads", icon: "google-ads.png" },
  { name: "Unity Ads", icon: "unity.png" },
  { name: "Meta", icon: "meta.png" },
  { name: "TikTok", icon: "tiktok.png" },
  { name: "Pangle", icon: "pangle.ico" },
  { name: "Mintegral", icon: "mintegral.png" },
  { name: "Liftoff", icon: "liftoff.png" },
  { name: "Moloco", icon: "moloco.png" },
  { name: "ironSource Exchange", icon: "ironsource.png" },
];
---

{compact ? (
  <div class="platform-preview">
    <span>Playable packages for</span>
    <a href="/playable-ads/#platforms">
      {platforms.slice(0, 5).map((platform) => <span class="platform-preview__item"><span class="platform-icon"><img src={`/assets/images/platforms/${platform.icon}`} width="96" height="96" alt="" /></span>{platform.name}</span>)}
      <span aria-hidden="true">↗</span>
    </a>
  </div>
) : (
  <section class="platforms section-shell" id="platforms" aria-labelledby="platforms-title" data-platform-carousel>
    <div class="platforms__heading">
      <div><p class="eyebrow">Target ad platforms</p><h2 id="platforms-title">Your playable. Your ad network.</h2></div>
      <div class="platforms__controls" hidden>
        <button type="button" aria-label="Previous platforms" data-platform-prev><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m14 6-6 6 6 6" /></svg></button>
        <button type="button" aria-label="Next platforms" data-platform-next><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m10 6 6 6-6 6" /></svg></button>
        <button type="button" aria-label="Pause automatic scrolling" aria-pressed="false" data-platform-pause><svg viewBox="0 0 24 24" aria-hidden="true"><path data-pause-icon d="M9 6v12M15 6v12" /></svg></button>
      </div>
    </div>
    <p class="platforms__intro">We prepare platform-specific playable packages, adapting the format, click-through integration, and responsive layout to your target networks.</p>
    <ul class="platforms__track" role="list" tabindex="0" aria-label="Playable ad platforms" data-platform-track>
      {platforms.map((platform) => <li><span class="platform-icon"><img src={`/assets/images/platforms/${platform.icon}`} width="96" height="96" alt="" loading="lazy" /></span><span>{platform.name}</span></li>)}
    </ul>
    <p class="platforms__scope">Target platforms and package requirements are agreed in your project scope.</p>
  </section>
)}

<style>
  .platform-preview { position: relative; z-index: 5; margin-top: 22px; font-size: .78rem; line-height: 1.6; pointer-events: auto; }
  .platform-preview > span { display: block; color: var(--quiet); }
  .platform-preview a { display: flex; justify-content: center; flex-wrap: wrap; align-items: center; gap: 8px 16px; margin-top: 6px; color: var(--muted); text-decoration: none; }
  .platform-preview__item { display: inline-flex; align-items: center; gap: 6px; white-space: nowrap; }
  .platform-icon { display: inline-grid; place-items: center; flex-shrink: 0; width: 48px; height: 48px; padding: 7px; border-radius: 10px; background: #fff; }
  .platform-icon img { display: block; width: 100%; height: 100%; object-fit: contain; }
  .platform-preview .platform-icon { width: 24px; height: 24px; padding: 4px; border-radius: 5px; }
  .platform-preview a:hover { color: var(--text); }
  .platforms { padding-block: clamp(40px, 5vw, 64px); scroll-margin-top: 100px; }
  .platforms__heading { display: flex; justify-content: space-between; align-items: end; gap: 20px; }
  .platforms h2 { margin: 12px 0 0; font-size: clamp(1.8rem, 3vw, 3rem); font-weight: 500; }
  .platforms__intro { max-width: 720px; margin: 20px 0 28px; }
  .platforms__controls:not([hidden]) { display: flex; gap: 8px; }
  .platforms__controls button { display: grid; place-items: center; width: 44px; height: 44px; padding: 0; border: 1px solid var(--line-strong); border-radius: 50%; background: transparent; color: var(--text); cursor: pointer; }
  .platforms__controls button:disabled { opacity: .3; cursor: default; }
  .platforms__controls button:not(:disabled):hover { background: var(--surface-solid); }
  .platforms__controls svg { width: 22px; fill: none; stroke: currentColor; stroke-width: 1.5; }
  .platforms__track { display: flex; overflow-x: auto; overscroll-behavior-x: contain; scroll-snap-type: x proximity; gap: 0; margin: 0; padding: 0 0 12px; list-style: none; scrollbar-width: thin; scrollbar-color: var(--line-strong) transparent; }
  .platforms__track li { flex: 0 0 auto; display: flex; align-items: center; justify-content: center; gap: 12px; min-width: 210px; min-height: 96px; padding: 18px 26px; border-block: 1px solid var(--line); scroll-snap-align: start; font-size: 1.25rem; font-weight: 500; white-space: nowrap; }
  .platforms__track li + li { border-left: 1px solid var(--line); }
  .platforms__scope { margin: 16px 0 0; color: var(--quiet); font-size: .82rem; }
  @media (max-width: 600px) {
    .platforms__heading { align-items: center; }
    .platforms__track li { min-width: 180px; min-height: 84px; padding-inline: 18px; font-size: 1.1rem; }
    .platforms__track .platform-icon { width: 40px; height: 40px; }
    .platform-preview { margin-top: 16px; font-size: .7rem; }
  }
  @media (orientation: landscape) and (max-height: 500px) {
    .platform-preview { margin-top: 10px; font-size: .7rem; }
    .platform-preview > span { display: none; }
    .platform-preview a { margin-top: 0; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>("[data-platform-carousel]").forEach((carousel) => {
    const track = carousel.querySelector<HTMLElement>("[data-platform-track]");
    const previous = carousel.querySelector<HTMLButtonElement>("[data-platform-prev]");
    const next = carousel.querySelector<HTMLButtonElement>("[data-platform-next]");
    const controls = carousel.querySelector<HTMLElement>(".platforms__controls");
    if (!track || !previous || !next || !controls) return;
    const pause = carousel.querySelector<HTMLButtonElement>("[data-platform-pause]");
    const pauseIcon = pause?.querySelector<SVGPathElement>("[data-pause-icon]");
    const originals = Array.from(track.children) as HTMLElement[];
    const motion = matchMedia("(prefers-reduced-motion: reduce)");
    // Extra copies allow both directions to wrap without a visible rewind.
    const copy = () => originals.map((item) => {
      const clone = item.cloneNode(true) as HTMLElement;
      clone.setAttribute("aria-hidden", "true");
      return clone;
    });
    track.prepend(...copy());
    track.append(...copy());
    track.style.scrollSnapType = "none";
    let cycleWidth = 0;
    let settleTimer: ReturnType<typeof setTimeout>;
    let timer: ReturnType<typeof setInterval> | undefined;
    let hovered = false;
    let focused = false;
    let visible = false;
    let paused = false;
    const normalize = () => {
      if (!cycleWidth) return;
      if (track.scrollLeft < cycleWidth) track.scrollLeft += cycleWidth;
      else if (track.scrollLeft >= cycleWidth * 2) track.scrollLeft -= cycleWidth;
    };
    const move = (direction: number) => {
      const items = Array.from(track.children) as HTMLElement[];
      const start = items[0].offsetLeft;
      const closest = items.reduce((best, item, index) =>
        Math.abs(item.offsetLeft - start - track.scrollLeft) < Math.abs(items[best].offsetLeft - start - track.scrollLeft) ? index : best, 0);
      const destination = items[closest + direction];
      if (destination) track.scrollTo({ left: destination.offsetLeft - start, behavior: motion.matches ? "instant" : "smooth" });
    };
    const updateTimer = () => {
      if (timer !== undefined) clearInterval(timer);
      timer = undefined;
      if (!paused && !hovered && !focused && visible && !document.hidden && !motion.matches) {
        timer = setInterval(() => move(1), 4000);
      }
    };
    const resize = () => {
      const first = track.children[0] as HTMLElement;
      cycleWidth = originals[0].offsetLeft - first.offsetLeft;
      track.scrollLeft = cycleWidth;
      controls.hidden = false;
    };
    previous.addEventListener("click", () => move(-1));
    next.addEventListener("click", () => move(1));
    pause?.addEventListener("click", () => {
      paused = !paused;
      pause.setAttribute("aria-pressed", String(paused));
      pause.setAttribute("aria-label", paused ? "Resume automatic scrolling" : "Pause automatic scrolling");
      pauseIcon?.setAttribute("d", paused ? "m9 6 9 6-9 6Z" : "M9 6v12M15 6v12");
      updateTimer();
    });
    carousel.addEventListener("mouseenter", () => { hovered = true; updateTimer(); });
    carousel.addEventListener("mouseleave", () => { hovered = false; updateTimer(); });
    carousel.addEventListener("focusin", () => { focused = true; updateTimer(); });
    carousel.addEventListener("focusout", (event) => {
      focused = event.relatedTarget instanceof Node && carousel.contains(event.relatedTarget);
      updateTimer();
    });
    track.addEventListener("keydown", (event) => {
      if (event.key === "ArrowLeft" || event.key === "ArrowRight") {
        event.preventDefault();
        move(event.key === "ArrowLeft" ? -1 : 1);
      }
    });
    track.addEventListener("scroll", () => {
      clearTimeout(settleTimer);
      settleTimer = setTimeout(normalize, 150);
    }, { passive: true });
    document.addEventListener("visibilitychange", updateTimer);
    motion.addEventListener("change", updateTimer);
    new IntersectionObserver(([entry]) => { visible = entry.isIntersecting; updateTimer(); }, { threshold: .2 }).observe(track);
    new ResizeObserver(resize).observe(track);
    document.fonts.ready.then(resize);
    resize();
  });
</script>
