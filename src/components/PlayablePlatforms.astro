---
interface Props { compact?: boolean }
const { compact = false } = Astro.props;
const platforms = ["AppLovin", "Google Ads", "Unity Ads", "Meta", "TikTok", "Pangle", "Mintegral", "Liftoff", "Moloco", "ironSource Exchange"];
---

{compact ? (
  <div class="platform-preview">
    <span>Playable packages for</span>
    <a href="/playable-ads/#platforms">{platforms.slice(0, 5).join(" · ")} <span aria-hidden="true">↗</span></a>
  </div>
) : (
  <section class="platforms section-shell" id="platforms" aria-labelledby="platforms-title" data-platform-carousel>
    <div class="platforms__heading">
      <div><p class="eyebrow">Target ad platforms</p><h2 id="platforms-title">Your playable. Your ad network.</h2></div>
      <div class="platforms__controls" hidden>
        <button type="button" aria-label="Previous platforms" data-platform-prev disabled><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m14 6-6 6 6 6" /></svg></button>
        <button type="button" aria-label="Next platforms" data-platform-next><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m10 6 6 6-6 6" /></svg></button>
      </div>
    </div>
    <p class="platforms__intro">We prepare platform-specific playable packages, adapting the format, click-through integration, and responsive layout to your target networks.</p>
    <ul class="platforms__track" role="list" tabindex="0" aria-label="Playable ad platforms" data-platform-track>
      {platforms.map((name) => <li>{name}</li>)}
    </ul>
    <p class="platforms__scope">Target platforms and package requirements are agreed in your project scope.</p>
  </section>
)}

<style>
  .platform-preview { position: relative; z-index: 5; margin-top: 22px; font-size: .78rem; line-height: 1.6; pointer-events: auto; }
  .platform-preview > span { display: block; color: var(--quiet); }
  .platform-preview a { color: var(--muted); text-decoration: none; }
  .platform-preview a:hover { color: var(--text); }
  .platforms { padding-block: clamp(40px, 5vw, 64px); scroll-margin-top: 100px; }
  .platforms__heading { display: flex; justify-content: space-between; align-items: end; gap: 20px; }
  .platforms h2 { margin: 12px 0 0; font-size: clamp(1.8rem, 3vw, 3rem); font-weight: 500; }
  .platforms__intro { max-width: 720px; margin: 20px 0 28px; }
  .platforms__controls:not([hidden]) { display: flex; gap: 8px; }
  .platforms__controls button { display: grid; place-items: center; width: 44px; height: 44px; padding: 0; border: 1px solid var(--line-strong); border-radius: 50%; background: transparent; color: var(--text); cursor: pointer; }
  .platforms__controls button:disabled { opacity: .3; cursor: default; }
  .platforms__controls button:not(:disabled):hover { background: var(--surface-solid); }
  .platforms__controls svg { width: 22px; fill: none; stroke: currentColor; stroke-width: 1.5; }
  .platforms__track { display: flex; overflow-x: auto; overscroll-behavior-x: contain; scroll-snap-type: x proximity; gap: 0; margin: 0; padding: 0 0 12px; list-style: none; scrollbar-width: thin; scrollbar-color: var(--line-strong) transparent; }
  .platforms__track li { flex: 0 0 auto; display: grid; place-items: center; min-width: 180px; min-height: 88px; padding: 18px 30px; border-block: 1px solid var(--line); scroll-snap-align: start; font-size: 1.25rem; font-weight: 500; white-space: nowrap; }
  .platforms__track li + li { border-left: 1px solid var(--line); }
  .platforms__scope { margin: 16px 0 0; color: var(--quiet); font-size: .82rem; }
  @media (max-width: 600px) {
    .platforms__heading { align-items: center; }
    .platforms__track li { min-width: 155px; min-height: 76px; padding-inline: 22px; font-size: 1.1rem; }
    .platform-preview { margin-top: 16px; font-size: .7rem; }
  }
  @media (orientation: landscape) and (max-height: 500px) {
    .platform-preview { margin-top: 10px; font-size: .7rem; }
    .platform-preview > span { display: inline; margin-right: 6px; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>("[data-platform-carousel]").forEach((carousel) => {
    const track = carousel.querySelector<HTMLElement>("[data-platform-track]");
    const previous = carousel.querySelector<HTMLButtonElement>("[data-platform-prev]");
    const next = carousel.querySelector<HTMLButtonElement>("[data-platform-next]");
    const controls = carousel.querySelector<HTMLElement>(".platforms__controls");
    if (!track || !previous || !next || !controls) return;
    const update = () => {
      previous.disabled = track.scrollLeft < 2;
      next.disabled = track.scrollLeft + track.clientWidth >= track.scrollWidth - 2;
      controls.hidden = track.scrollWidth <= track.clientWidth + 2;
    };
    const move = (direction: number) => track.scrollBy({
      left: direction * track.clientWidth * .75,
      behavior: matchMedia("(prefers-reduced-motion: reduce)").matches ? "instant" : "smooth",
    });
    previous.addEventListener("click", () => move(-1));
    next.addEventListener("click", () => move(1));
    track.addEventListener("scroll", update, { passive: true });
    new ResizeObserver(update).observe(track);
    document.fonts.ready.then(update);
    update();
  });
</script>
