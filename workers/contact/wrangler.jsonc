{
  "name": "aniloom-contact",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-05",
  "workers_dev": true,
  "durable_objects": { "bindings": [{ "name": "CONTACT_GATE", "class_name": "ContactGate" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ContactGate"] }],
  "vars": {
    "ALLOWED_ORIGINS": "https://aniloom.tech,https://www.aniloom.tech",
    "DAILY_LIMIT": "100"
  },
  "observability": { "enabled": false }
}
